        {"@id": "pkg:deb/ubuntu/libgcrypt20@1.12.0-2ubuntu1?arch=amd64&distro=ubuntu-26.04"}
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "The issue is an RSA decryption timing side channel. The runtime GPG verifier is removed and a bounded executable-link audit found no remaining executable under /usr/bin, /usr/sbin, or /usr/share/cattle linked to libgcrypt."
