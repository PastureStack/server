# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ghcr.io/pasturestack/server:v1.6.282
FROM ${BASE_IMAGE}

ARG PASTURESTACK_SERVER_REVISION

LABEL org.opencontainers.image.source="https://github.com/PastureStack/server" \
      org.opencontainers.image.description="PastureStack server compatibility image with bounded Catalog bootstrap recovery." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="v1.6.283" \
      org.opencontainers.image.revision="${PASTURESTACK_SERVER_REVISION}" \
      org.opencontainers.image.base.name="ghcr.io/pasturestack/server:v1.6.282"

ENV CATTLE_RANCHER_SERVER_VERSION=v1.6.283
ENV PASTURESTACK_CATALOG_COMMIT=3cfb447d7564cf9bada4bac2e15ce3dd6b221615
ENV DEFAULT_CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"3cfb447d7564cf9bada4bac2e15ce3dd6b221615"}}}'
ENV CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"3cfb447d7564cf9bada4bac2e15ce3dd6b221615"}}}'

COPY patches/websocket-proxy-wrapper.sh /usr/local/lib/pasturestack/service-wrapper

RUN set -eux; \
    chmod 0755 /usr/local/lib/pasturestack/service-wrapper; \
    for service in \
        websocket-proxy \
        compose-executor \
        host-provisioner \
        catalog-service \
        authentication-service; do \
      install -m 0755 /usr/local/lib/pasturestack/service-wrapper "/usr/bin/${service}"; \
    done; \
    ln -sfn compose-executor /usr/bin/rancher-compose-executor; \
    ln -sfn host-provisioner /usr/bin/go-machine-service; \
    ln -sfn catalog-service /usr/bin/rancher-catalog-service; \
    ln -sfn authentication-service /usr/bin/rancher-auth-service; \
    bash -n /usr/bin/catalog-service
