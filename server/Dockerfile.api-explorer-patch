FROM ${GO_BUILDER_IMAGE} AS console_broker_build

WORKDIR /src
COPY console-broker/go.mod console-broker/go.sum ./
RUN set -eux; \
    test "$(/usr/local/go/bin/go version | awk '{print $3}')" = go1.27.0; \
    /usr/local/go/bin/go mod download; \
    /usr/local/go/bin/go mod verify
