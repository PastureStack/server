ARG ZLIB_VERSION=1.3.2
ARG ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

WORKDIR /src
COPY patches/coreutils-CVE-2026-56391.patch /src/coreutils-CVE-2026-56391.patch
RUN set -eux; \
    echo "${COREUTILS_UNIQ_PATCH_SHA256}  /src/coreutils-CVE-2026-56391.patch" | sha256sum -c -; \
    grep -F "Upstream-Commit: ${COREUTILS_UNIQ_FIX_COMMIT}" /src/coreutils-CVE-2026-56391.patch; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 300 \
        -o coreutils.tar.gz \
        "https://ftp.gnu.org/gnu/coreutils/coreutils-${COREUTILS_VERSION}.tar.gz"; \
    echo "${COREUTILS_SHA256}  coreutils.tar.gz" | sha256sum -c -; \
    tar -xzf coreutils.tar.gz; \
    cd "coreutils-${COREUTILS_VERSION}"; \
    git apply --check --no-index /src/coreutils-CVE-2026-56391.patch; \
    git apply --no-index /src/coreutils-CVE-2026-56391.patch; \
    FORCE_UNSAFE_CONFIGURE=1 ./configure --disable-nls; \
    make -j"$(nproc)"; \
    install -D -m 0755 src/uniq /out/coreutils/uniq; \
    install -D -m 0644 COPYING /out/coreutils/COPYING; \
    test "$(printf 'a\na\nb\n' | /out/coreutils/uniq -c | awk 'NR == 1 { print $1 ":" $2 }')" = '2:a'; \
    longline="$(printf '\360\237\230\200'; head -c 255 /dev/zero | tr '\0' A)"; \
    printf '%s\n%s\n' "${longline}" "${longline}" >/tmp/uniq-input; \
    printf '%s\n' "${longline}" >/tmp/uniq-expected; \
    LC_ALL=C.UTF-8 /out/coreutils/uniq -w256 /tmp/uniq-input >/tmp/uniq-output; \
    cmp /tmp/uniq-expected /tmp/uniq-output; \
    /out/coreutils/uniq --version | grep -F "uniq (GNU coreutils) ${COREUTILS_VERSION}"; \
    cd /src; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 300 \
        -o zlib.tar.gz \
        "https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz"; \
    echo "${ZLIB_SHA256}  zlib.tar.gz" | sha256sum -c -; \
    tar -xzf zlib.tar.gz; \
    cd "zlib-${ZLIB_VERSION}"; \
    ./configure --prefix=/out/zlib --libdir=/out/zlib/lib; \
    make -j"$(nproc)"; \
    make test; \
    make install; \
    test -s "/out/zlib/lib/libz.so.${ZLIB_VERSION}"; \
    install -D -m 0644 LICENSE /out/zlib/LICENSE

FROM hardened_tools_build AS openssl_build

ARG OPENSSL_VERSION=3.5.8
ARG OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2
ARG SOURCE_DATE_EPOCH

WORKDIR /src
RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    export SOURCE_DATE_EPOCH; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 300 \
        -o openssl.tar.gz \
        "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz"; \
    echo "${OPENSSL_SHA256}  openssl.tar.gz" | sha256sum -c -; \
    tar -xzf openssl.tar.gz; \
    cd "openssl-${OPENSSL_VERSION}"; \
    CPPFLAGS="-I/out/zlib/include" \
    LDFLAGS="-L/out/zlib/lib" \
      ./Configure linux-x86_64 \
        --prefix=/usr \
        --openssldir=/usr/lib/ssl \
        --libdir=lib/x86_64-linux-gnu \
        shared zlib; \
    make -j"$(nproc)"; \
    LD_LIBRARY_PATH="/out/zlib/lib:${LD_LIBRARY_PATH:-}" \
      make test TESTS=test_evp_extra; \
    make install_sw DESTDIR=/out/openssl; \
    LD_LIBRARY_PATH="/out/openssl/usr/lib/x86_64-linux-gnu:/out/zlib/lib:${LD_LIBRARY_PATH:-}" \
      /out/openssl/usr/bin/openssl version -a | \
      grep -F "OpenSSL ${OPENSSL_VERSION} 25 Aug 2026"; \
    test -s /out/openssl/usr/lib/x86_64-linux-gnu/libcrypto.so.3; \
    test -s /out/openssl/usr/lib/x86_64-linux-gnu/libssl.so.3; \
    test -s /out/openssl/usr/lib/x86_64-linux-gnu/ossl-modules/legacy.so

