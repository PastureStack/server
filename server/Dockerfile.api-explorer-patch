            --retry 5 \
            --retry-all-errors \
            --retry-delay 2 \
            --connect-timeout 10 \
            --max-time 300 \
            -o "${output}" \
            "${url}"; \
        echo "${expected}  ${output}" | sha256sum -c -; \
    }; \
    safe_extract_xz() { \
        archive="$1"; destination="$2"; listing="${archive}.list"; \
        mkdir -p "${destination}"; \
        tar -tJf "${archive}" >"${listing}"; \
        if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
            echo "Unsafe runtime archive path: ${archive}" >&2; \
            exit 1; \
        fi; \
        if sort "${listing}" | uniq -d | grep -q .; then \
            echo "Duplicate runtime archive path: ${archive}" >&2; \
            exit 1; \
        fi; \
        if tar -tvJf "${archive}" | grep -Eq '^[lh]'; then \
            echo "Runtime archive may not contain links: ${archive}" >&2; \
            exit 1; \
        fi; \
        tar --no-same-owner --no-same-permissions -xJf "${archive}" -C "${destination}"; \
        test -z "$(find "${destination}" -type l -print -quit)"; \
    }; \
    auth_archive="${runtime_stage}/authentication-service.tar.xz"; \
