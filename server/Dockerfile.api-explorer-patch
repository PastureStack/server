    done; \
    test ! -e "${stage}/js/bootstrap.js"; \
    grep -F '"version": "1.1.18"' "${stage}/version.json" >/dev/null; \
    grep -F '"commit": "3b1c39e"' "${stage}/version.json" >/dev/null; \
    grep -aF 'PastureStackUi' "${stage}/ui.js" >/dev/null; \
    grep -aF 'pasturestack:modal:shown' "${stage}/ui.js" >/dev/null; \
    grep -aF 'data-pasturestack-toggle' "${stage}/ui.js" >/dev/null; \
    grep -E 'Bootstrap +v5\.3\.8' "${stage}/ui.css" >/dev/null; \
    grep -F 'url("./fonts/bootstrap-icons.woff2' "${stage}/ui.css" >/dev/null; \
    if grep -F 'Bootstrap v3.' "${stage}/ui.css"; then \
        echo "Rejected EOL Bootstrap 3 stylesheet in API Explorer" >&2; \
        exit 1; \
    fi; \
    if grep -aEq 'Bootstrap v3\.4\.1|bs\.(button|tooltip|popover|modal|dropdown)|data-loading-text|data-toggle="dropdown"' \
        "${stage}/ui.js"; then \
        echo "Rejected Bootstrap executable surface found in API Explorer" >&2; \
        exit 1; \
    fi; \
    web_root="$(readlink -f /usr/share/cattle/war)"; \
    api_dir="${web_root}/api-ui"; \
    case "${api_dir}" in \
        /usr/share/cattle/*/api-ui) ;; \
        *) echo "Unsafe API Explorer destination: ${api_dir}" >&2; exit 1 ;; \
    esac; \
    rm -rf "${api_dir}"; \
    mkdir -p "${api_dir}"; \
    cp -a "${stage}/." "${api_dir}/"; \
    find "${api_dir}" -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    rm -rf "${archive}" "${listing}" "${stage}"; \
    touch -d "@${SOURCE_DATE_EPOCH}" "${web_root}" /tmp

