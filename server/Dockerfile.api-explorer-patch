RUN set -eux; \
    /usr/local/go/bin/go test ./...; \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=local \
      /usr/local/go/bin/go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags='-s -w -buildid=' \
        -o /out/pasturestack-console-broker .

