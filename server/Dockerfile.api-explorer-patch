RUN set -eu; \
    archive=/tmp/api-explorer.tar.gz; \
    listing=/tmp/api-explorer-files.txt; \
    stage=/tmp/pasturestack-api-explorer; \
    curl -fsSL \
        --retry 5 \
        --retry-all-errors \
        --retry-delay 2 \
        --connect-timeout 10 \
        --max-time 300 \
        -o "${archive}" \
        "${API_EXPLORER_RELEASE_BASE_URL%/}/${API_EXPLORER_RELEASE_TAG}/${API_EXPLORER_ARTIFACT}"; \
    echo "${API_EXPLORER_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    tar -tzf "${archive}" >"${listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
        echo "Unsafe API Explorer archive path" >&2; \
        exit 1; \
    fi; \
    if sort "${listing}" | uniq -d | grep -q .; then \
        echo "Duplicate API Explorer archive path" >&2; \
        exit 1; \
    fi; \
    if tar -tvzf "${archive}" | grep -Eq '^[lh]'; then \
        echo "API Explorer archive may not contain links" >&2; \
        exit 1; \
    fi; \
    while IFS= read -r member; do \
        clean="${member#./}"; \
        case "${clean}" in \
            ''|fonts/|fonts/*|licenses/|licenses/*|ui.css|ui.js|ui.min.css|ui.min.js|version.json) ;; \
            *) echo "Unexpected API Explorer archive member: ${member}" >&2; exit 1 ;; \
        esac; \
    done <"${listing}"; \
    rm -rf "${stage}"; \
    mkdir -p "${stage}"; \
    tar --no-same-owner --no-same-permissions -xzf "${archive}" -C "${stage}"; \
    test -z "$(find "${stage}" -type l -print -quit)"; \
    for required in \
        ui.css \
        ui.js \
        ui.min.css \
        ui.min.js \
        version.json \
        fonts/bootstrap-icons.woff \
        fonts/bootstrap-icons.woff2 \
        licenses/LICENSE.txt \
        licenses/THIRD-PARTY-NOTICES.md \
        licenses/bootstrap-5.3.8/LICENSE \
        licenses/bootstrap-icons-1.13.1/LICENSE \
        licenses/jquery-4.0.0/LICENSE.txt \
        licenses/handlebars-4.7.9/LICENSE \
        licenses/inherited-vendor/LICENSE-async-0.9.0 \
        licenses/inherited-vendor/LICENSE-jquery-scrollintoview-1.8 \
        licenses/inherited-vendor/LICENSE-jsonformatter-2009 \
        licenses/inherited-vendor/NOTICE-json2; do \
        test -s "${stage}/${required}"; \
    done; \
    test ! -e "${stage}/js/bootstrap.js"; \
    grep -F '"version": "1.1.17"' "${stage}/version.json" >/dev/null; \
    grep -F '"commit": "94e617e"' "${stage}/version.json" >/dev/null; \
    grep -aF 'PastureStackUi' "${stage}/ui.js" >/dev/null; \
    grep -aF 'pasturestack:modal:shown' "${stage}/ui.js" >/dev/null; \
    grep -aF 'data-pasturestack-toggle' "${stage}/ui.js" >/dev/null; \
    grep -E 'Bootstrap +v5\.3\.8' "${stage}/ui.css" >/dev/null; \
    grep -F 'url("./fonts/bootstrap-icons.woff2' "${stage}/ui.css" >/dev/null; \
    if grep -F 'Bootstrap v3.' "${stage}/ui.css"; then \
        echo "Rejected EOL Bootstrap 3 stylesheet in API Explorer" >&2; \
        exit 1; \
    fi; \
    if grep -aEq 'Bootstrap v3\.4\.1|bs\.(button|tooltip|popover|modal|dropdown)|data-loading-text|data-toggle="dropdown"' \
        "${stage}/ui.js"; then \
        echo "Rejected Bootstrap executable surface found in API Explorer" >&2; \
        exit 1; \
    fi; \
    web_root="$(readlink -f /usr/share/cattle/war)"; \
    api_dir="${web_root}/api-ui"; \
    case "${api_dir}" in \
        /usr/share/cattle/*/api-ui) ;; \
        *) echo "Unsafe API Explorer destination: ${api_dir}" >&2; exit 1 ;; \
    esac; \
    rm -rf "${api_dir}"; \
    mkdir -p "${api_dir}"; \
    cp -a "${stage}/." "${api_dir}/"; \
    find "${api_dir}" -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    rm -rf "${archive}" "${listing}" "${stage}"; \
    touch -d "@${SOURCE_DATE_EPOCH}" "${web_root}" /tmp

