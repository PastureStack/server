# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=ghcr.io/pasturestack/server:v1.6.278
FROM ${BASE_IMAGE}

ARG PASTURESTACK_SERVER_REVISION
ARG SOURCE_DATE_EPOCH
ARG WEB_CONSOLE_RELEASE_TAG=v1.6.56-pasturestack.5
ARG WEB_CONSOLE_ARTIFACT=web-console-1.6.56-pasturestack.5.tar.gz
ARG WEB_CONSOLE_ARTIFACT_SHA256=c5e8343f5165bfa7fd4ecb9e123387056059a8c5ec39f698ffcd98b2e946bf62

RUN set -eu; \
    archive=/tmp/web-console.tar.gz; \
    manifest=/tmp/web-console-files.txt; \
    curl -fsSL \
        --retry 5 \
        --retry-all-errors \
        --retry-delay 2 \
        --connect-timeout 10 \
        --max-time 300 \
        -o "${archive}" \
        "https://github.com/PastureStack/web-console/releases/download/${WEB_CONSOLE_RELEASE_TAG}/${WEB_CONSOLE_ARTIFACT}"; \
    echo "${WEB_CONSOLE_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    tar -tzf "${archive}" >"${manifest}"; \
    test "$(grep -Ec '^1\.6\.56/index\.html$' "${manifest}")" -eq 1; \
    test "$(grep -Ec '^1\.6\.56/translations/zh-tw\.json$' "${manifest}")" -eq 1; \
    test "$(grep -Ec '^1\.6\.56/assets/ui[^/]*\.js$' "${manifest}")" -eq 1; \
    if grep -Eq '(^/|(^|/)\.\.(/|$)|\.map$)' "${manifest}"; then \
        echo "Unsafe or unpublished Web Console path" >&2; \
        exit 1; \
    fi; \
    find /usr/share/cattle/war/assets \
        -maxdepth 1 \
        -type f \
        -name 'ui-*.js' \
        -delete; \
    tar -xzf "${archive}" \
        -C /usr/share/cattle/war \
        --strip-components=1; \
    test -f /usr/share/cattle/war/index.html; \
    test -f /usr/share/cattle/war/translations/zh-tw.json; \
    ui_entry="$(find /usr/share/cattle/war/assets \
        -maxdepth 1 \
        -type f \
        -name 'ui-*.js' \
        -print -quit)"; \
    test -n "${ui_entry}"; \
    grep -F 'io.pasturestack.catalog.' "${ui_entry}" >/dev/null; \
    grep -F 'localizedName' "${ui_entry}" >/dev/null; \
    grep -F '"service":"服務"' \
        /usr/share/cattle/war/translations/zh-tw.json >/dev/null; \
    if ! perl -CSD -Mutf8 -0777 -e \
        '$$text = <>; exit($$text =~ /[·•・･]/ ? 1 : 0)' \
        /usr/share/cattle/war/translations/zh-tw.json; then \
        echo "Stray middle-dot punctuation in Taiwan localization" >&2; \
        exit 1; \
    fi; \
    rm -f "${archive}" "${manifest}"

LABEL org.opencontainers.image.source="https://github.com/PastureStack/server" \
      org.opencontainers.image.description="PastureStack server compatibility image with localized Catalog metadata." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="v1.6.279" \
      org.opencontainers.image.revision="${PASTURESTACK_SERVER_REVISION}" \
      org.opencontainers.image.base.name="ghcr.io/pasturestack/server:v1.6.278"

ENV CATTLE_RANCHER_SERVER_VERSION=v1.6.279
ENV PASTURESTACK_WEB_CONSOLE_COMMIT=2dd5e5b0154ddbb8e41ef2887fa786b93e74827b
ENV PASTURESTACK_WEB_CONSOLE_PACKAGE=1.6.56-pasturestack.5
ENV PASTURESTACK_WEB_CONSOLE_ARTIFACT_SHA256=c5e8343f5165bfa7fd4ecb9e123387056059a8c5ec39f698ffcd98b2e946bf62
ENV PASTURESTACK_CATALOG_COMMIT=f28c1d4d03b19cd7d8cd273573f8eb2a8da0ddda
ENV DEFAULT_CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"f28c1d4d03b19cd7d8cd273573f8eb2a8da0ddda"}}}'
ENV CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"f28c1d4d03b19cd7d8cd273573f8eb2a8da0ddda"}}}'
