RUN set -eu; \
    archive=/tmp/orchestration-engine.jar; \
    listing=/tmp/orchestration-engine-files.txt; \
    curl -fsSL \
        --retry 5 \
        --retry-all-errors \
        --retry-delay 2 \
        --connect-timeout 10 \
        --max-time 600 \
        -o "${archive}" \
        "${ORCHESTRATION_ENGINE_RELEASE_BASE_URL%/}/${ORCHESTRATION_ENGINE_RELEASE_TAG}/${ORCHESTRATION_ENGINE_ARTIFACT}"; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    jar tf "${archive}" >"${listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
        echo "Unsafe Orchestration Engine archive path" >&2; \
        exit 1; \
    fi; \
    test "$(grep -Fxc 'WEB-INF/web.xml' "${listing}")" -eq 1; \
    test "$(grep -Fxc 'io/cattle/platform/launcher/Main.class' "${listing}")" -eq 1; \
    for module in \
        app-config \
        iaas-api-logic \
        iaas-auth-logic \
        iaas-model \
        iaas-service-discovery-api \
        resources; do \
        test "$(grep -Ec "^WEB-INF/lib/cattle-${module}-0\\.183\\.280\\.jar$" "${listing}")" -eq 1; \
    done; \
    old_web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${old_web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe existing document root" >&2; exit 1 ;; \
    esac; \
    test -L /usr/share/cattle/war; \
    test -d "${old_web_root}/api-ui"; \
    cp -a "${old_web_root}/api-ui" /tmp/pasturestack-api-ui; \
    install -m 0644 "${archive}" /usr/share/cattle/cattle.jar; \
    engine_hash="$(sha256sum /usr/share/cattle/cattle.jar | awk '{print $1}')"; \
    new_web_root="/usr/share/cattle/${engine_hash}"; \
    test "${new_web_root}" != "${old_web_root}"; \
    rm /usr/share/cattle/war; \
    rm -rf "${old_web_root}" "${new_web_root}"; \
    mkdir -p "${new_web_root}"; \
    ln -s "${engine_hash}" /usr/share/cattle/war; \
    cd "${new_web_root}"; \
    unzip -q ../cattle.jar; \
    if [ -f resources.jar ]; then \
        unzip -oq resources.jar; \
        rm -f resources.jar; \
    fi; \
    resources_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name 'cattle-resources-0.183.280.jar' -print -quit)"; \
    test -n "${resources_jar}"; \
    source_date_iso="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%SZ')"; \
    cd /tmp/pasturestack-server-overlays; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/service/service-auth.json \
        config-content/bootstrap/bootstrap.sh \
        db/core-060.xml \
        db/core-124.xml; \
    mkdir -p schema/v1; \
    jar xf "${resources_jar}" \
        schema/v1/admin.ser \
        schema/v1/base.ser \
        schema/v1/member.ser \
        schema/v1/owner.ser \
        schema/v1/project.ser \
        schema/v1/projectadmin.ser \
        schema/v1/readAdmin.ser \
        schema/v1/readonly.ser \
        schema/v1/restricted.ser \
        schema/v1/service.ser \
        schema/v1/superadmin.ser \
        schema/v1/user.ser; \
    javac -cp "${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe.java; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/v1/admin.ser \
        schema/v1/service.ser; \
    cd "${new_web_root}"; \
    rm -rf api-ui; \
    mv /tmp/pasturestack-api-ui api-ui; \
    api_logic="$(find WEB-INF/lib -maxdepth 1 -type f \
        -name 'cattle-iaas-api-logic-0.183.280.jar' -print -quit)"; \
    model="$(find WEB-INF/lib -maxdepth 1 -type f \
        -name 'cattle-iaas-model-0.183.280.jar' -print -quit)"; \
    app_config="$(find WEB-INF/lib -maxdepth 1 -type f \
        -name 'cattle-app-config-0.183.280.jar' -print -quit)"; \
    service_discovery="$(find WEB-INF/lib -maxdepth 1 -type f \
        -name 'cattle-iaas-service-discovery-api-0.183.280.jar' -print -quit)"; \
    test -n "${api_logic}"; \
    test -n "${model}"; \
    test -n "${app_config}"; \
    test -n "${service_discovery}"; \
    for class_name in \
        io/cattle/platform/iaas/api/port/PortPreflightActionHandler.class \
        io/cattle/platform/iaas/api/port/PortPreflightService.class; do \
        test "$(unzip -Z1 "${api_logic}" | grep -Fxc "${class_name}")" -eq 1; \
    done; \
    unzip -p "${api_logic}" \
        io/cattle/platform/iaas/api/port/PortPreflightService.class \
        | grep -aF 'host.port.check' >/dev/null; \
    unzip -p "${api_logic}" \
        io/cattle/platform/iaas/api/port/PortPreflightService.class \
        | grep -aF 'active_port_conflict_on_other_host' >/dev/null; \
    for class_name in \
        io/cattle/platform/core/addon/PortPreflightConflict.class \
        io/cattle/platform/core/addon/PortPreflightInput.class \
        io/cattle/platform/core/addon/PortPreflightResult.class \
        io/cattle/platform/core/util/PortBindingAddress.class; do \
        test "$(unzip -Z1 "${model}" | grep -Fxc "${class_name}")" -eq 1; \
    done; \
    unzip -p "${api_logic}" schema/base/project.json.d/port-preflight.json \
        | grep -F '"portpreflight"' >/dev/null; \
    unzip -p "${resources_jar}" schema/user/user-auth.json \
        | grep -F '"portPreflightInput" : "r"' >/dev/null; \
    unzip -p "${resources_jar}" schema/user/user-auth.json \
        | grep -F '"portPreflightInput.ports" : "cr"' >/dev/null; \
    unzip -p "${resources_jar}" schema/user/user-auth.json \
        | grep -F '"portPreflightResult.conflicts" : "r"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"portPreflightInput" : "cr"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"portPreflightPort" : "cr"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"portPreflightResult" : "r"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"portPreflightConflict" : "r"' >/dev/null; \
    unzip -p "${app_config}" io/cattle/platform/app/ApiServerConfig.class \
        | grep -aF 'PortPreflightService' >/dev/null; \
    for class_name in \
        io/cattle/platform/iaas/api/filter/instance/InstanceVolumesValidationFilter.class \
        io/cattle/platform/iaas/api/volume/VolumePreflightActionHandler.class \
        io/cattle/platform/iaas/api/volume/VolumePreflightInputs.class \
        io/cattle/platform/iaas/api/volume/VolumePreflightService.class; do \
        test "$(unzip -Z1 "${api_logic}" | grep -Fxc "${class_name}")" -eq 1; \
    done; \
    unzip -p "${api_logic}" schema/base/project.json.d/volume-preflight.json \
        | grep -F '"volumepreflight"' >/dev/null; \
    for class_name in \
        io/cattle/platform/core/addon/VolumePreflightInput.class \
        io/cattle/platform/core/addon/VolumePreflightIssue.class \
        io/cattle/platform/core/addon/VolumePreflightResult.class; do \
        test "$(unzip -Z1 "${model}" | grep -Fxc "${class_name}")" -eq 1; \
    done; \
    unzip -p "${resources_jar}" schema/user/user-auth.json \
        | grep -F '"volumePreflightInput.dataVolumes" : "cr"' >/dev/null; \
    unzip -p "${resources_jar}" schema/user/user-auth.json \
        | grep -F '"volumePreflightResult.issues" : "r"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"volumePreflightInput" : "cr"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"volumePreflightResult" : "r"' >/dev/null; \
    unzip -p "${resources_jar}" schema/project/project-auth.json \
        | grep -F '"volumePreflightIssue" : "r"' >/dev/null; \
    unzip -p "${app_config}" io/cattle/platform/app/ApiServerConfig.class \
        | grep -aF 'VolumePreflightActionHandler' >/dev/null; \
    for class_name in \
        io/cattle/platform/servicediscovery/api/filter/ServiceValidationFilter.class \
        io/cattle/platform/servicediscovery/api/filter/ServiceUpgradeValidationFilter.class; do \
        test "$(unzip -Z1 "${service_discovery}" | grep -Fxc "${class_name}")" -eq 1; \
        unzip -p "${service_discovery}" "${class_name}" \
            | grep -aF 'VolumePreflightService' >/dev/null; \
    done; \
    unzip -p "${resources_jar}" db/core-124.xml \
        | grep -F 'pasturestack-catalog-pinned-commit' >/dev/null; \
    unzip -p "${resources_jar}" schema/service/service-auth.json \
        | grep -F '"subscribe": "cr"' >/dev/null; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" \
        /usr/share/cattle/cattle.jar \
        /usr/share/cattle/war \
        "${new_web_root}" \
        "${new_web_root}/api-ui" \
        /tmp; \
    rm -rf /tmp/pasturestack-server-overlays; \
    rm -f "${archive}" "${listing}"

RUN set -eu; \
    linux_archive="/tmp/${NODE_AGENT_LINUX_ARTIFACT}"; \
    windows_archive="/tmp/${NODE_AGENT_WINDOWS_ARTIFACT}"; \
    linux_listing=/tmp/node-agent-linux-files.txt; \
    windows_listing=/tmp/node-agent-windows-files.txt; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${linux_archive}" \
        "${NODE_AGENT_RELEASE_BASE_URL%/}/${NODE_AGENT_RELEASE_TAG}/${NODE_AGENT_LINUX_ARTIFACT}"; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${windows_archive}" \
        "${NODE_AGENT_RELEASE_BASE_URL%/}/${NODE_AGENT_RELEASE_TAG}/${NODE_AGENT_WINDOWS_ARTIFACT}"; \
    echo "${NODE_AGENT_LINUX_ARTIFACT_SHA256}  ${linux_archive}" | sha256sum -c -; \
    echo "${NODE_AGENT_WINDOWS_ARTIFACT_SHA256}  ${windows_archive}" | sha256sum -c -; \
    tar -tzf "${linux_archive}" >"${linux_listing}"; \
    unzip -Z1 "${windows_archive}" >"${windows_listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${linux_listing}" "${windows_listing}"; then \
        echo "Unsafe Node Agent archive path" >&2; \
        exit 1; \
    fi; \
    gzip -t "${linux_archive}"; \
    unzip -t "${windows_archive}" >/dev/null; \
    install -m 0644 "${linux_archive}" \
        "/usr/share/cattle/artifacts/${NODE_AGENT_LINUX_ARTIFACT}"; \
    install -m 0644 "${windows_archive}" \
        "/usr/share/cattle/artifacts/${NODE_AGENT_WINDOWS_ARTIFACT}"; \
    ln -sfn "${NODE_AGENT_LINUX_ARTIFACT}" /usr/share/cattle/artifacts/go-agent.tar.gz; \
    sed -i -E \
        -e "s|node-agent-0\\.13\\.[0-9]+\\.tar\\.gz|${NODE_AGENT_LINUX_ARTIFACT}|g" \
        -e "s|node-agent-0\\.13\\.[0-9]+-windows-amd64\\.zip|${NODE_AGENT_WINDOWS_ARTIFACT}|g" \
        /usr/share/cattle/env_vars; \
    grep -Fx \
        "export CATTLE_AGENT_PACKAGE_PYTHON_AGENT_URL=/usr/share/cattle/artifacts/${NODE_AGENT_LINUX_ARTIFACT}" \
        /usr/share/cattle/env_vars >/dev/null; \
    grep -Fx \
        "export CATTLE_AGENT_PACKAGE_WINDOWS_AGENT_URL=/usr/share/cattle/artifacts/${NODE_AGENT_WINDOWS_ARTIFACT}" \
        /usr/share/cattle/env_vars >/dev/null; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" \
        "/usr/share/cattle/artifacts/${NODE_AGENT_LINUX_ARTIFACT}" \
        "/usr/share/cattle/artifacts/${NODE_AGENT_WINDOWS_ARTIFACT}" \
        /usr/share/cattle/artifacts/go-agent.tar.gz \
        /usr/share/cattle/env_vars \
        /tmp; \
    rm -f "${linux_archive}" "${windows_archive}" \
        "${linux_listing}" "${windows_listing}"

