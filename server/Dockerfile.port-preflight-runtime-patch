            *) echo "Unexpected Web Console archive member: ${member}" >&2; exit 1 ;; \
        esac; \
    done <"${listing}"; \
    rm -rf "${stage}"; \
    mkdir -p "${stage}"; \
    tar --no-same-owner --no-same-permissions -xzf "${archive}" -C "${stage}"; \
    test -z "$(find "${stage}" -type l -print -quit)"; \
    package_root="${stage}/1.6.56"; \
    for required in \
        VERSION.txt \
        favicon.ico \
        index.html \
        humans.txt \
        robots.txt \
        assets \
        assets/ui-light.css \
        assets/ui-light.rtl.css \
        assets/ui-dark.css \
        assets/ui-dark.rtl.css \
        ember-fetch \
        licenses \
        licenses/ember/LICENSE \
        licenses/ember/UPSTREAM.md \
        licenses/ember-fetch/LICENSE.md \
        licenses/ember-fetch/UPSTREAM.md \
