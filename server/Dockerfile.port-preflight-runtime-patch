ARG ORCHESTRATION_ENGINE_COMMIT=dbcf3b091f686de6339df00d2e20a27cbbfd713a

ARG NODE_AGENT_RELEASE_BASE_URL=https://github.com/PastureStack/node-agent/releases/download
ARG NODE_AGENT_RELEASE_TAG=v0.13.22
ARG NODE_AGENT_LINUX_ARTIFACT=node-agent-0.13.22.tar.gz
