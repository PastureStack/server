ARG WEB_CONSOLE_COMMIT=d9e6ad05208ba940304b29312003b0c2849ea686

RUN set -eu; \
    archive=/tmp/web-console.tar.gz; \
    listing=/tmp/web-console-files.txt; \
    stage=/tmp/pasturestack-web-console; \
    curl -fsSL \
        --retry 5 \
        --retry-all-errors \
        --retry-delay 2 \
        --connect-timeout 10 \
