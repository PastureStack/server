        licenses/runtime/ember-modifier/LICENSE.md \
        licenses/runtime/ember-modifier/UPSTREAM.md; do \
        test -s "${package_root}/${required_file}"; \
    done; \
    test "$(cat "${package_root}/VERSION.txt")" = "1.6.56"; \
    test "$(find "${package_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test ! -e "${package_root}/translations/none.json"; \
    test "$(find "${package_root}" -type f -name '*.map' | wc -l)" -eq 0; \
    echo "84e97eb6663fa5fa07f36661e6040ab8a557b165c13860e2e72c1a692ca3c2a0  ${package_root}/licenses/ember/LICENSE" \
        | sha256sum -c -; \
    grep -Fx -- '- Distribution: `ember-source@6.12.0`' \
