        | sha256sum -c -; \
    grep -F -- '- Upstream version: `5.1.3`' \
        "${package_root}/licenses/ember-fetch/UPSTREAM.md" >/dev/null; \
    echo "0c454de6bb0a94445b9fe315cdad6830e317ca6aa9fb04d0b84fe000d04a5c90  ${package_root}/licenses/ember-power-select/LICENSE.md" \
        | sha256sum -c -; \
    grep -F -- '- Upstream version: `1.0.0-beta.19`' \
        "${package_root}/licenses/ember-power-select/UPSTREAM.md" >/dev/null; \
    echo "c3cd4817d1568725ab93dced4bd46f0dceaeace8c6badb9d12e2239fced7e810  ${package_root}/licenses/ember-basic-dropdown/LICENSE.md" \
