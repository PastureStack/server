    echo "fee7ff7079edfdbac1c78d0329da16ae9b6ef73405cec197ed6136ddf1d70117  ${package_root}/licenses/runtime/ember-power-select/LICENSE.md" \
        | sha256sum -c -; \
    grep -F -- '- Upstream version: `9.0.2`' \
        "${package_root}/licenses/runtime/ember-power-select/UPSTREAM.md" >/dev/null; \
    echo "fee7ff7079edfdbac1c78d0329da16ae9b6ef73405cec197ed6136ddf1d70117  ${package_root}/licenses/runtime/ember-basic-dropdown/LICENSE.md" \
        | sha256sum -c -; \
    grep -F -- '- Upstream version: `9.0.0`' \
        "${package_root}/licenses/runtime/ember-basic-dropdown/UPSTREAM.md" >/dev/null; \
    echo "c7543891093cb613eeb5a90c16a18fa25b8708a0c7c1c67691202384ff9b6567  ${package_root}/licenses/runtime/ember-concurrency/LICENSE.md" \
