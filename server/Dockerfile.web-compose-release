RUN set -eux; \
    go test ./...; \
    mkdir -p /out; \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=local \
      go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags='-s -w -buildid=' \
        -o /out/pasturestack-console-broker .

