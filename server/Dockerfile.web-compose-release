FROM ${ARTIFACT_HELPER_IMAGE} AS console_broker_build

WORKDIR /src
COPY console-broker/go.mod console-broker/go.sum ./
RUN set -eux; \
    test "$(go version | awk '{print $3}')" = go1.27.2; \
    go mod download; \
    go mod verify
COPY console-broker/*.go ./
RUN set -eux; \
    go test ./...; \
    mkdir -p /out; \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOTOOLCHAIN=local \
      go build \
        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags='-s -w -buildid=' \
        -o /out/pasturestack-console-broker .

FROM scratch AS component_input
COPY artifacts/component-input.txt /remote-input.txt

