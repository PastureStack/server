    tar -tvJf "${catalog_archive}" > /tmp/pasturestack-archive-verbose.txt; \
    if grep -Eq '^[lh]' /tmp/pasturestack-archive-verbose.txt; then \
        echo 'Catalog Service archive may not contain links' >&2; \
        exit 1; \
    fi; \
    mkdir -p /out/catalog-service; \
    tar --no-same-owner --no-same-permissions -xJf "${catalog_archive}" -C /out/catalog-service; \
    echo "${CATALOG_SERVICE_BINARY_SHA256}  /out/catalog-service/catalog-service" | sha256sum -c -; \
    echo "${CATALOG_SERVICE_SQLITE_BINARY_SHA256}  /out/catalog-service/catalog-service-sqlite" | sha256sum -c -; \
    for catalog_binary in catalog-service catalog-service-sqlite; do \
        chmod 0755 "/out/catalog-service/${catalog_binary}"; \
