        -mod=readonly \
        -trimpath \
        -buildvcs=false \
        -ldflags='-s -w -buildid=' \
        -o /out/pasturestack-console-broker .; \
    test "$(go version -m /out/pasturestack-console-broker | awk 'NR==1 {print $2}')" = go1.27.3;

