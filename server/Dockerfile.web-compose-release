RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    test -n "${PASTURESTACK_SERVER_REVISION}"; \
    archive=/tmp/orchestration-engine.jar; \
    listing=/tmp/orchestration-engine-files.txt; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    unzip -Z1 "${archive}" >"${listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
        echo 'Unsafe Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    if sort "${listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    unzip -p "${archive}" META-INF/MANIFEST.MF | tr -d '\r' | \
        grep -Fx "Implementation-Version: ${ORCHESTRATION_ENGINE_VERSION}" >/dev/null; \
    test "$(grep -Ec '^WEB-INF/lib/freemarker-2\.3\.35\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/freemarker-2\.3\.(3[0-4]|[0-2][0-9])\.jar$' "${listing}"; \
    test "$(grep -Ec '^WEB-INF/lib/hazelcast-5\.7\.5\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/hazelcast-(5\.7\.[0-4]|5\.7\.3-pasturestack\.[0-9]+)([.-]|\.jar$)' "${listing}"; \
    old_web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${old_web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe existing document root: ${old_web_root}" >&2; exit 1 ;; \
    esac; \
    test -L /usr/share/cattle/war; \
    test -d "${old_web_root}/api-ui"; \
    cp -a "${old_web_root}/api-ui" /tmp/pasturestack-api-ui; \
    install -m 0644 "${archive}" /usr/share/cattle/cattle.jar; \
    engine_hash="$(sha256sum /usr/share/cattle/cattle.jar | awk '{print $1}')"; \
    new_web_root="/usr/share/cattle/${engine_hash}"; \
    if [ "${new_web_root}" != "${old_web_root}" ]; then \
        rm /usr/share/cattle/war; \
        rm -rf "${old_web_root}" "${new_web_root}"; \
        mkdir -p "${new_web_root}"; \
        ln -s "${engine_hash}" /usr/share/cattle/war; \
        cd "${new_web_root}"; \
        unzip -q ../cattle.jar; \
        if [ -f resources.jar ]; then \
            unzip -oq resources.jar; \
            rm -f resources.jar; \
        fi; \
    else \
        test "$(readlink -f /usr/share/cattle/war)" = "${new_web_root}"; \
        test -d "${new_web_root}/WEB-INF/lib"; \
    fi; \
    resources_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name "cattle-resources-${ORCHESTRATION_ENGINE_VERSION}.jar" -print -quit)"; \
    test -n "${resources_jar}"; \
    unzip -p "${resources_jar}" schema/user/user-auth.json | \
        grep -F '"volume.isNative" : "r"' >/dev/null; \
    test "$(unzip -p "${resources_jar}" schema/v1/readonly.ser | sha256sum | cut -d' ' -f1)" = \
        "${ENGINE_READONLY_SCHEMA_SHA256}"; \
    test "$(unzip -p "${resources_jar}" schema/v1/restricted.ser | sha256sum | cut -d' ' -f1)" = \
        "${ENGINE_RESTRICTED_SCHEMA_SHA256}"; \
    unzip -p "${resources_jar}" schema/base/mfaOperation.json | \
        grep -F 'oidcAccessPolicyUpdate' >/dev/null; \
    unzip -p "${resources_jar}" schema/base/mfaOperation.json | \
        grep -F '"requestDigest"' >/dev/null; \
    unzip -p "${resources_jar}" schema/token/token-auth.json | \
        grep -F '"token.clientSessionId": "cro"' >/dev/null; \
    for frozen_token_schema in base superadmin token; do \
        unzip -p "${resources_jar}" "schema/v1/${frozen_token_schema}.ser" | \
            grep -aF 'clientSessionId' >/dev/null; \
    done; \
    unzip -p "${resources_jar}" cattle-global.properties | \
        grep -Fx 'auth.service.external.id.types=github_user,github_org,github_team,shibboleth_user,shibboleth_group,ldap_user,ldap_group,oidc_user,oidc_group' >/dev/null; \
    for oidc_type in oidc_user oidc_group; do \
        unzip -p "${resources_jar}" schema/base/projectMember.json | \
            grep -F "\"${oidc_type}\"" >/dev/null; \
    done; \
    app_config_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name "cattle-app-config-${ORCHESTRATION_ENGINE_VERSION}.jar" -print -quit)"; \
    test -n "${app_config_jar}"; \
    unzip -p "${app_config_jar}" META-INF/cattle/iaas-api/defaults.properties | \
        grep -Fx 'auth.service.external.id.types=github_user,github_org,github_team,shibboleth_user,shibboleth_group,ldap_user,ldap_group,oidc_user,oidc_group' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'supported.docker.range=~v1.12.3 || ~v1.13.0 || ~v17.03.0 || ~v17.06.0 || ~v17.09.0 || ~v17.12.0 || ~v18.03.0 || ~v18.06.0 || ~v18.09.0 || ~v19.03.2 || v24.0.9 || >=v29.4.1 <=v29.7.2 || v29.8.0' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'newest.docker.version=v29.8.0' >/dev/null; \
    source_date_iso="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%SZ')"; \
    cd /tmp/pasturestack-server-overlays; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/service/service-auth.json \
        config-content/bootstrap/bootstrap.sh \
        db/core-060.xml \
        db/core-124.xml; \
    mkdir -p schema/v1; \
    jar xf "${resources_jar}" \
        schema/v1/admin.ser \
        schema/v1/base.ser \
        schema/v1/member.ser \
        schema/v1/owner.ser \
        schema/v1/project.ser \
        schema/v1/projectadmin.ser \
        schema/v1/readAdmin.ser \
        schema/v1/readonly.ser \
        schema/v1/restricted.ser \
        schema/v1/service.ser \
        schema/v1/superadmin.ser \
        schema/v1/user.ser; \
    javac -cp "${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe.java; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify-hardware; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/v1/admin.ser \
        schema/v1/service.ser; \
    cd "${new_web_root}"; \
    rm -rf api-ui; \
    mv /tmp/pasturestack-api-ui api-ui; \
    test "$(readlink -f /usr/share/cattle/war)" = "${new_web_root}"; \
    unzip -p "${resources_jar}" db/core-124.xml | \
        grep -F 'pasturestack-catalog-pinned-commit' >/dev/null; \
    unzip -p "${resources_jar}" schema/service/service-auth.json | \
        grep -F '"subscribe": "cr"' >/dev/null; \
    unzip -p "${resources_jar}" db/core-125.xml | \
        grep -F 'pasturestack-credential-secret-value-mediumtext' >/dev/null; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" \
        /usr/share/cattle/cattle.jar \
        /usr/share/cattle/war \
        "${new_web_root}" \
        "${new_web_root}/api-ui" \
        /tmp; \
    rm -rf /tmp/pasturestack-server-overlays; \
    rm -f "${archive}" "${listing}"

RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    test -n "${PASTURESTACK_SERVER_REVISION}"; \
    web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe Web Console document root: ${web_root}" >&2; exit 1 ;; \
    esac; \
    rm -rf \
        "${web_root}/assets" \
        "${web_root}/ember-fetch" \
        "${web_root}/licenses" \
        "${web_root}/translations"; \
    rm -f \
        "${web_root}/VERSION.txt" \
        "${web_root}/favicon.ico" \
        "${web_root}/humans.txt" \
        "${web_root}/index.html" \
        "${web_root}/robots.txt"; \
    cp -a /tmp/pasturestack-web-console/. "${web_root}/"; \
    rm -rf /tmp/pasturestack-web-console; \
    find "${web_root}/assets" "${web_root}/licenses" "${web_root}/translations" \
        -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    touch -d "@${SOURCE_DATE_EPOCH}" \
        "${web_root}/VERSION.txt" \
        "${web_root}/favicon.ico" \
        "${web_root}/humans.txt" \
        "${web_root}/index.html" \
        "${web_root}/robots.txt" \
        "${web_root}"; \
    test "$(cat "${web_root}/VERSION.txt")" = "${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(find "${web_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test -z "$(find "${web_root}" -type f -name '*.map' -print -quit)"; \
    ui_entry="$(find "${web_root}/assets" -maxdepth 1 -type f -name 'ui-*.js' -print -quit)"; \
    test -n "${ui_entry}"; \
    grep -aF 'growl-mount' "${ui_entry}" >/dev/null; \
    grep -aF 'createIdentity' "${web_root}"/assets/*.js >/dev/null; \
    grep -aF 'hasRecord' "${web_root}"/assets/*.js >/dev/null; \
    for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do \
        theme_path="${web_root}/assets/${theme_asset}"; \
        grep -F -A 2 ".jGrowl.top-right {" "${theme_path}" | grep -Fx "  top: 45px;" >/dev/null; \
        grep -F -A 4 ".jGrowl .jGrowl-closer {" "${theme_path}" | grep -Fx "  max-width: calc(100vw - 20px);" >/dev/null; \
        grep -F -A 5 "#growl-mount .jGrowl.top-right {" "${theme_path}" | grep -Fx "  position: static;" >/dev/null; \
        grep -F -A 3 '.pods .pod-empty-message {' "${theme_path}" | grep -Fx '  white-space: normal;' >/dev/null; \
        grep -F -A 3 '.pods .pod-empty-message {' "${theme_path}" | grep -Fx '  overflow-wrap: anywhere;' >/dev/null; \
        grep -F 'footer .footer-dropdown .dropdown-menu' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-host-guidance' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-advanced-content.resource-advanced-grid' "${theme_path}" >/dev/null; \
    done; \
    grep -F '"formResources.addUlimit":"新增限制"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"hostsPage.permissionDenied":"您沒有權限在此環境中新增主機。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.title":"無法執行此操作"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.denied":"您沒有權限在此環境中建立此資源。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.updateDenied":"您沒有權限在此環境中更新此資源。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"containersPage.permissionDenied":"您沒有權限在此環境中新增容器。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"hookPage.receiver.permissionDenied":"您沒有權限在此環境中新增接收端 Webhook。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"hookPage.receiver.editPermissionDenied":"此環境不提供編輯接收端 Webhook 的功能。"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"viewEditProject.error.projectUnavailable":"找不到此環境' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"viewEditProject.error.membersNotSaved":"成員變更未完成' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"viewEditProject.error.loadFailed":"暫時無法載入環境資料' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"viewEditProject.error.projectFailed":"環境設定未儲存：伺服器暫時無法處理' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"inputIdentity.error.forbidden":"您沒有權限搜尋' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"resourceLoadError.stackUnavailable":"找不到此應用堆疊' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"resourceLoadError.serviceUnavailable":"找不到此服務' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"resourceLoadError.secretsUnavailable":"無法載入機密資料' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"resourceLoadError.accountsUnavailable":"無法載入帳號資料' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    ui_entry="$(find "${web_root}/assets" -maxdepth 1 -type f -name 'ui-*.js' -print -quit)"; \
    test -n "${ui_entry}"; \
    for permission_key in \
        hostsPage.permissionDenied \
        containersPage.permissionDenied \
        hookPage.receiver.permissionDenied \
        hookPage.receiver.editPermissionDenied \
        routePermission.title \
        routePermission.denied \
        routePermission.updateDenied; do \
        grep -aF "${permission_key}" "${ui_entry}" >/dev/null; \
    done; \
    for permission_locale in en-us zh-tw ja-jp; do \
        locale_file="${web_root}/translations/${permission_locale}.json"; \
        for permission_key in routePermission.title routePermission.denied routePermission.updateDenied; do \
            grep -F "\"${permission_key}\":" "${locale_file}" >/dev/null; \
        done; \
    done; \
    grep -aF 'pod-empty-message text-center text-muted' "${ui_entry}" >/dev/null; \
    for marker in \
        oidcAccessPolicyUpdate \
        LocalRecoveryRequired \
        MfaConfirmationRequired \
        InvalidAllowedIdentity \
        resourceLoadError.stackUnavailable \
        resourceLoadError.serviceUnavailable \
        resourceLoadError.serviceFailed \
        resourceLoadError.secretsUnavailable \
        resourceLoadError.secretsFailed; do \
        grep -aF "${marker}" "${ui_entry}" >/dev/null; \
    done; \
    for load_key in serviceUnavailable serviceFailed secretsUnavailable secretsFailed; do \
        grep -F "\"resourceLoadError.${load_key}\":" \
            "${web_root}/translations/zh-tw.json" >/dev/null; \
    done; \
    echo "${AUTHENTICATION_SERVICE_BINARY_SHA256}  /usr/bin/authentication-service.real" | sha256sum -c -; \
    echo "${CATALOG_SERVICE_BINARY_SHA256}  /usr/bin/catalog-service.real" | sha256sum -c -; \
    echo "${CATALOG_SERVICE_SQLITE_BINARY_SHA256}  /usr/bin/catalog-service-sqlite" | sha256sum -c -; \
    test "$(/usr/bin/catalog-service.real --version)" = "v${CATALOG_SERVICE_VERSION}"; \
    test "$(/usr/bin/catalog-service-sqlite --version)" = "v${CATALOG_SERVICE_VERSION}"; \
    echo "${CATALOG_SERVICE_LICENSE_SHA256}  /usr/share/licenses/pasturestack/catalog-service/LICENSE.txt" | sha256sum -c -; \
    grep -Fx "Release source commit: ${CATALOG_SERVICE_COMMIT}" \
        /usr/share/licenses/pasturestack/catalog-service/SOURCES.txt >/dev/null; \
    /usr/bin/authentication-service.real --version | \
        grep -F "${AUTHENTICATION_SERVICE_VERSION}" >/dev/null; \
    for marker in \
        oidcAccessPolicyUpdate \
        LocalRecoveryRequired \
        MfaConfirmationRequired \
        InvalidAllowedIdentity; do \
        grep -aF "${marker}" /usr/bin/authentication-service.real >/dev/null; \
    done; \
    echo "${WEBSOCKET_PROXY_BINARY_SHA256}  /usr/bin/websocket-proxy.real" | sha256sum -c -; \
    /usr/bin/websocket-proxy.real --help 2>&1 | grep -F -- '-platform-public-origin' >/dev/null; \
    touch -d "@${SOURCE_DATE_EPOCH}" /usr/bin/websocket-proxy.real; \
    echo "${WEBHOOK_AUTOMATION_SERVICE_BINARY_SHA256}  /usr/bin/webhook-automation-service" | sha256sum -c -; \
    test "$(/usr/bin/webhook-automation-service --version)" = "webhook-automation-service version ${WEBHOOK_AUTOMATION_SERVICE_VERSION}"; \
    test "$(readlink -f /usr/bin/webhook-service)" = /usr/bin/webhook-automation-service; \
    for name in COMPATIBILITY.md LICENSES.txt SOURCES.txt THIRD-PARTY-NOTICES.md; do \
        test -s "/usr/share/licenses/pasturestack/webhook-automation-service/webhook-automation-service-${name}"; \
    done; \
    grep -Fx "Release source commit: ${WEBHOOK_AUTOMATION_SERVICE_COMMIT}" \
        /usr/share/licenses/pasturestack/webhook-automation-service/webhook-automation-service-SOURCES.txt >/dev/null; \
    echo "${COMPOSE_EXECUTOR_BINARY_SHA256}  /usr/bin/compose-executor.real" | sha256sum -c -; \
    compose_version_output="$(/usr/bin/compose-executor.real --version 2>&1)"; \
    test "${compose_version_output}" = "pasturestack-compose version ${COMPOSE_EXECUTOR_VERSION}"; \
    echo "${GOVC_BINARY_SHA256}  /usr/bin/govc" | sha256sum -c -; \
    test "$(/usr/bin/govc version)" = "govc ${VSPHERE_CLI_BUNDLE_VERSION}"; \
    test -s /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-LICENSES.txt; \
    test -s /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-THIRD-PARTY-NOTICES.txt; \
    grep -Fx 'Pinned source commit: a668d9c60399552ea96782b8751c956720a0b8fb' \
        /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt >/dev/null; \
    grep -Fx 'Security dependency: golang.org/x/text v0.41.0' \
        /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt >/dev/null

