COPY scripts/install-ubuntu-security-updates.sh security/ubuntu-security-packages.lock security/ubuntu-perl-security.lock artifacts/verify-pcre2-runtime.sh artifacts/verify-brotli-runtime.sh /tmp/pasturestack-security-input/
# Keep the official zlib backport active: ldconfig otherwise prefers the old
# upstream 1.3.2 library, which is affected by USN-8954-1 / CVE-2026-85091.
# Retain the base image's removed, unused Git DAV/Expat surface after updating.
RUN --mount=from=ubuntu_security_backports,source=/out,target=/opt/pasturestack/ubuntu-security-backports,ro \
    set -eux; \
    printf '%s\n' "${WEB_CONSOLE_COMMIT}" | grep -Eq '^[0-9a-f]{40}$'; \
    cd /tmp/pasturestack-runtime-security; \
    install -D -m 0755 /tmp/pasturestack-security-input/verify-pcre2-runtime.sh /usr/local/libexec/pasturestack/verify-pcre2-runtime.sh; \
    sha256sum -c SHA256SUMS; \
    install -m 0755 tar /usr/bin/tar; \
    . /etc/os-release; \
    test "$ID:$VERSION_ID" = ubuntu:26.04; \
    test "$(dpkg --print-architecture)" = amd64; \
    for package in apt libapt-pkg7.0; do \
      test "$(dpkg-query -W -f='${db:Status-Status}' "$package")" = installed; \
      test "$(dpkg-query -W -f='${Architecture}' "$package")" = amd64; \
      dpkg --compare-versions "$(dpkg-query -W -f='${Version}' "$package")" le "${APT_PACKAGE_VERSION}"; \
      package_file="packages/${package}_${APT_PACKAGE_VERSION}_amd64.deb"; \
      test "$(dpkg-deb -f "$package_file" Package)" = "$package"; \
      test "$(dpkg-deb -f "$package_file" Version)" = "${APT_PACKAGE_VERSION}"; \
      test "$(dpkg-deb -f "$package_file" Architecture)" = amd64; \
    done; \
    apt_configuration_before="$(find /etc/apt -type f -exec sha256sum {} + | LC_ALL=C sort)"; \
    dpkg -i packages/*.deb; \
    for package in apt libapt-pkg7.0; do \
      test "$(dpkg-query -W -f='${Version}' "$package")" = "${APT_PACKAGE_VERSION}"; \
      test "$(dpkg-query -W -f='${db:Status-Status}' "$package")" = installed; \
    done; \
    test "$(find /etc/apt -type f -exec sha256sum {} + | LC_ALL=C sort)" = "$apt_configuration_before"; \
    install -D -m 0644 official-apt/lock.json /usr/share/pasturestack/security/apt-official/lock.json; \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\t${db:Status-Status}\n' apt libapt-pkg7.0 > /usr/share/pasturestack/security/apt-official/runtime-packages.tsv; \
    install -D -m 0644 /tmp/pasturestack-security-input/ubuntu-security-packages.lock /usr/share/pasturestack/security/ubuntu-security-packages.lock; \
    sh /tmp/pasturestack-security-input/install-ubuntu-security-updates.sh /usr/share/pasturestack/security/ubuntu-security-packages.lock /tmp/pasturestack-runtime-security/security-updates; \
    install -D -m 0644 /tmp/pasturestack-security-input/ubuntu-perl-security.lock /usr/share/pasturestack/security/ubuntu-perl-security.lock; \
    sh /tmp/pasturestack-security-input/install-ubuntu-security-updates.sh /usr/share/pasturestack/security/ubuntu-perl-security.lock /tmp/pasturestack-runtime-security/perl-security-updates; \
    install -D -m 0644 perl-security-updates/manifest.tsv /usr/share/pasturestack/security/ubuntu-perl-security-manifest.tsv; \
    for package in libperl5.40 perl perl-base perl-modules-5.40; do \
        test "$(dpkg-query -W -f='${Version}' "$package")" = "${PERL_PACKAGE_VERSION}"; \
    done; \
    perl -MPod::Text -e 'die "Pod::Text unavailable" unless $Pod::Text::VERSION'; \
    rm -f /usr/lib/x86_64-linux-gnu/libz.so.1.3.2; \
    ldconfig; \
    test "$(readlink -f /usr/lib/x86_64-linux-gnu/libz.so.1)" = /usr/lib/x86_64-linux-gnu/libz.so.1.3.1; \
    zlib_integrity="$(dpkg --verify zlib1g)"; \
    test -z "${zlib_integrity}"; \
    printf '%s  %s\n' 27fa6c6cb94fb5b099ead61758a300dbc392d1dbf307fff6c16a9b8e57fdc9de /usr/lib/x86_64-linux-gnu/libz.so.1.3.1 | sha256sum -c -; \
    test ! -e /usr/lib/git-core/git-http-push; \
    rm -f /usr/lib/x86_64-linux-gnu/libexpat.so.1 /usr/lib/x86_64-linux-gnu/libexpat.so.1.11.2; \
    ldconfig; \
    data=/opt/pasturestack/ubuntu-security-backports; \
    evidence=/usr/share/pasturestack/security/ubuntu-backports; \
    mkdir -p "${evidence}"; \
    for package in rust-coreutils jq libjq1 libc6-dev libc-dev-bin libpcre2-dev libp11-kit-dev libxrender-dev; do \
      test "$(dpkg-query -W -f='${db:Status-Status}' "${package}" 2>/dev/null || true)" != installed; \
    done; \
    "${data}/install-existing-backports" --install-in-docker-build > "${evidence}/install.json"; \
    "${data}/install-existing-backports" --verify-installed > "${evidence}/verify.json"; \
    for package in libc6 libc-bin libc-gconv-modules-extra; do \
      archive="official-glibc/${package}.deb"; \
      test "$(dpkg-deb -f "$archive" Package)" = "$package"; \
      test "$(dpkg-deb -f "$archive" Architecture)" = amd64; \
      test "$(dpkg-deb -f "$archive" Version)" = "${GLIBC_RUNTIME_PACKAGE_VERSION}"; \
    done; \
    DEBIAN_FRONTEND=noninteractive dpkg --path-include='/usr/share/doc/libc6/*' \
      --path-include='/usr/share/man/man1/getconf.1.gz' --path-include='/usr/share/man/man1/tzselect.1.gz' \
      --install official-glibc/libc6.deb official-glibc/libc-bin.deb official-glibc/libc-gconv-modules-extra.deb; \
    glibc_audit="$(dpkg --audit)"; \
    test -z "$glibc_audit"; \
    for package in libc6 libc-bin libc-gconv-modules-extra; do \
      integrity="$(dpkg --verify "$package")"; \
      test -z "$integrity"; \
    done; \
    install -D -m 0755 /tmp/pasturestack-security-input/verify-brotli-runtime.sh /usr/local/libexec/pasturestack/verify-brotli-runtime.sh; \
    install -D -m 0644 official-brotli/lock.json /usr/share/pasturestack/security/brotli-official/lock.json; \
    sh /usr/local/libexec/pasturestack/verify-brotli-runtime.sh --install > /usr/share/pasturestack/security/brotli-official/runtime.json; \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = "${BROTLI_PACKAGE_VERSION}"; \
    brotli_integrity="$(dpkg --verify libbrotli1)"; \
    test -z "$brotli_integrity"; \
    for library in libbrotlicommon.so.1 libbrotlidec.so.1 libbrotlienc.so.1; do \
      linkage="$(ldd -r "/usr/lib/x86_64-linux-gnu/${library}" 2>&1)"; \
      if printf '%s\n' "${linkage}" | grep -E 'not found|undefined symbol'; then exit 1; fi; \
    done; \
    for document in manifest.json qualification.json openvex.json source-inputs.lock.json; do \
      install -m 0644 "${data}/${document}" "${evidence}/${document}"; \
    done; \
    printf '%s\n' 'ghcr.io/pasturestack/ubuntu-security-backports:v0.1.1@sha256:45d6b507b63a18459ae5cf76afd4d9731f8ef43b9c40e4c3dbb01899e1752b19' > "${evidence}/bundle-image.txt"; \
    (cd "${evidence}" && sha256sum manifest.json qualification.json openvex.json source-inputs.lock.json install.json verify.json bundle-image.txt > SHA256SUMS); \
    for package in libc6 libc-bin libc-gconv-modules-extra; do \
      test "$(dpkg-query -W -f='${Version}' "${package}")" = "${GLIBC_RUNTIME_PACKAGE_VERSION}"; \
    done; \
    for package in libpcre2-8-0 libpcre2-posix3; do \
      test "$(dpkg-query -W -f='${Version}' "${package}")" = "${PCRE2_PACKAGE_VERSION}"; \
      test -z "$(dpkg --verify "${package}")"; \
    done; \
    install -m 0644 pcre2-backport-provenance.json pcre2-backport.lock.json pcre2-runtime.sha256 /usr/share/pasturestack/security/; \
    sh /usr/local/libexec/pasturestack/verify-pcre2-runtime.sh; \
    /opt/java/openjdk/bin/java -version 2>&1 | grep -F '25.0.5'; \
    install -D -m 0644 security-updates/manifest.tsv /usr/share/pasturestack/security/ubuntu-security-updates-manifest.tsv; \
    rm -rf /tmp/pasturestack-security-input; \
    test "$(dpkg-query -W -f='${Version}' ca-certificates)" = "${CA_CERTIFICATES_PACKAGE_VERSION}"; \
    for package in curl libcurl3t64-gnutls libcurl4t64; do \
        test "$(dpkg-query -W -f='${Version}' "${package}")" = "${CURL_PACKAGE_VERSION}"; \
    done; \
    for package in openssl libssl3t64 openssl-provider-legacy; do \
        test "$(dpkg-query -W -f='${Version}' "${package}")" = "${OPENSSL_PACKAGE_VERSION}"; \
    done; \
    test "$(dpkg-query -W -f='${Version}' libdbi-perl)" = "${LIBDBI_PERL_PACKAGE_VERSION}"; \
    test "$(dpkg-query -W -f='${Version}' libfreetype6)" = "${FREETYPE_PACKAGE_VERSION}"; \
    test "$(dpkg-query -W -f='${Version}' libpng16-16t64)" = "${LIBPNG_PACKAGE_VERSION}"; \
    install -D -m 0644 libdbi-perl-runtime.sha256 /usr/share/pasturestack/security/libdbi-perl-runtime.sha256; \
    install -D -m 0644 freetype-runtime.sha256 /usr/share/pasturestack/security/freetype-runtime.sha256; \
    install -D -m 0644 libpng-runtime.sha256 /usr/share/pasturestack/security/libpng-runtime.sha256; \
    install -D -m 0644 openssl-runtime.sha256 /usr/share/pasturestack/security/openssl-runtime.sha256; \
    cd /; \
    test "$(wc -l < /usr/share/pasturestack/security/freetype-runtime.sha256)" -eq 1; \
    sha256sum -c /usr/share/pasturestack/security/freetype-runtime.sha256; \
    test "$(wc -l < /usr/share/pasturestack/security/libpng-runtime.sha256)" -eq 1; \
    sha256sum -c /usr/share/pasturestack/security/libpng-runtime.sha256; \
    libpng_linkage="$(ldd -r /usr/lib/x86_64-linux-gnu/libpng16.so.16 2>&1)"; \
    if printf '%s\n' "${libpng_linkage}" | grep -E 'not found|undefined symbol'; then \
        echo 'Unresolved libpng runtime linkage' >&2; exit 1; \
    fi; \
    test "$(readlink -f /usr/lib/x86_64-linux-gnu/libfreetype.so.6)" = /usr/lib/x86_64-linux-gnu/libfreetype.so.6.20.5; \
    freetype_linkage="$(ldd -r /usr/lib/x86_64-linux-gnu/libfreetype.so.6 2>&1)"; \
    if printf '%s\n' "${freetype_linkage}" | grep -E 'not found|undefined symbol'; then \
        echo 'Unresolved freetype runtime linkage' >&2; exit 1; \
    fi; \
    test "$(wc -l < /usr/share/pasturestack/security/libdbi-perl-runtime.sha256)" -eq 2; \
    sha256sum -c /usr/share/pasturestack/security/libdbi-perl-runtime.sha256; \
    perl -MDBI -e 'die "Unexpected DBI runtime version\n" unless $DBI::VERSION eq "1.647"'; \
    test "$(wc -l < /usr/share/pasturestack/security/openssl-runtime.sha256)" -eq 7; \
    sha256sum -c /usr/share/pasturestack/security/openssl-runtime.sha256; \
    openssl version | grep -E '^OpenSSL 3\.5\.5 .*\(Library: OpenSSL 3\.5\.5 '; \
    rm -rf /tmp/pasturestack-runtime-security /usr/share/licenses/pasturestack/openssl-3.5.8; \
    rm -f /usr/bin/tar

