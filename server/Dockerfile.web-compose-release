# syntax=docker/dockerfile:1.7
ARG ARTIFACT_HELPER_IMAGE=golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452
ARG BASE_IMAGE=ghcr.io/pasturestack/server:v1.6.401@sha256:961ea3de0f550a84034bd18c2f2cb39d72822310887c4605f12fa6dcdb9fddcb

FROM ${ARTIFACT_HELPER_IMAGE} AS release_artifacts

ARG WEB_CONSOLE_RELEASE_BASE_URL=https://github.com/PastureStack/web-console/releases/download
ARG WEB_CONSOLE_RELEASE_TAG=1.6.102
ARG WEB_CONSOLE_ARTIFACT=web-console-1.6.102.tar.gz
ARG WEB_CONSOLE_ARTIFACT_SHA256=6269235a9a23a43b025ca78269ea7d807108c36b007f3eb65c5369c639261bb1
ARG ORCHESTRATION_ENGINE_RELEASE_BASE_URL=https://github.com/PastureStack/orchestration-engine/releases/download
ARG ORCHESTRATION_ENGINE_RELEASE_TAG=v0.183.291
ARG ORCHESTRATION_ENGINE_ARTIFACT=orchestration-engine-0.183.291.jar
ARG ORCHESTRATION_ENGINE_ARTIFACT_SHA256=2dd6d0637df1fd5e8fc7cafd184f0048ec9ff4b81ac0211f09ab935de0e19615
ARG COMPOSE_EXECUTOR_VERSION=0.14.36
ARG COMPOSE_EXECUTOR_ARCHIVE_SHA256=47e2ba1686c1b136c7edcac530495c3e29c351e947f0b4d08ebe68d33f98cf66
ARG COMPOSE_EXECUTOR_BINARY_SHA256=1f542ee2dd76c7af06bc5f056c381d7e77aecaeac40f8d897df6df24a9902c0d

RUN set -eux; \
    command -v curl; \
    command -v gzip; \
    command -v sha256sum; \
    command -v tar; \
    web_archive=/tmp/web-console.tar.gz; \
    web_listing=/tmp/web-console-files.txt; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${web_archive}" \
        "${WEB_CONSOLE_RELEASE_BASE_URL%/}/${WEB_CONSOLE_RELEASE_TAG}/${WEB_CONSOLE_ARTIFACT}"; \
    echo "${WEB_CONSOLE_ARTIFACT_SHA256}  ${web_archive}" | sha256sum -c -; \
    tar -tzf "${web_archive}" >"${web_listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${web_listing}"; then \
        echo 'Unsafe Web Console archive path' >&2; \
        exit 1; \
    fi; \
    if sort "${web_listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate Web Console archive path' >&2; \
        exit 1; \
    fi; \
    if tar -tvzf "${web_archive}" | grep -Eq '^[lh]'; then \
        echo 'Web Console archive may not contain links' >&2; \
        exit 1; \
    fi; \
    while IFS= read -r member; do \
        clean="${member#./}"; \
        case "${clean}" in \
            ${WEB_CONSOLE_RELEASE_TAG}/|${WEB_CONSOLE_RELEASE_TAG}/*) ;; \
            *) echo "Unexpected Web Console archive member: ${member}" >&2; exit 1 ;; \
        esac; \
    done <"${web_listing}"; \
    mkdir -p /out/web-console /tmp/web-console; \
    tar --no-same-owner --no-same-permissions -xzf "${web_archive}" -C /tmp/web-console; \
    package_root="/tmp/web-console/${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(cat "${package_root}/VERSION.txt")" = "${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(find "${package_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test -z "$(find "${package_root}" -type l -print -quit)"; \
    test -z "$(find "${package_root}" -type f -name '*.map' -print -quit)"; \
    ui_entry="$(find "${package_root}/assets" -maxdepth 1 -type f -name 'ui-*.js' -print -quit)"; \
    test -n "${ui_entry}"; \
    grep -aF 'footer-dropdown' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-host-guidance' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-advanced-grid' "${ui_entry}" >/dev/null; \
    for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do \
        theme_path="${package_root}/assets/${theme_asset}"; \
        grep -F 'footer .footer-dropdown .dropdown-menu' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-host-guidance' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-advanced-content.resource-advanced-grid' "${theme_path}" >/dev/null; \
    done; \
    grep -F '"formResources.addUlimit":"新增限制"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    for locale_file in "${package_root}"/translations/*.json; do \
        grep -F '"formResources.addUlimit":' "${locale_file}" >/dev/null; \
    done; \
    cp -a "${package_root}/." /out/web-console/; \
    compose_archive=/tmp/compose-executor.gz; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${compose_archive}" \
        "https://github.com/PastureStack/compose-cli/releases/download/v${COMPOSE_EXECUTOR_VERSION}/compose-executor-${COMPOSE_EXECUTOR_VERSION}-linux-amd64.gz"; \
    echo "${COMPOSE_EXECUTOR_ARCHIVE_SHA256}  ${compose_archive}" | sha256sum -c -; \
    gzip -dc "${compose_archive}" >/out/compose-executor; \
    chmod 0755 /out/compose-executor; \
    echo "${COMPOSE_EXECUTOR_BINARY_SHA256}  /out/compose-executor" | sha256sum -c -; \
    compose_version_output="$(/out/compose-executor --version 2>&1)"; \
    test "${compose_version_output}" = "compose-executor version ${COMPOSE_EXECUTOR_VERSION}"; \
    engine_archive=/out/orchestration-engine.jar; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${engine_archive}" \
        "${ORCHESTRATION_ENGINE_RELEASE_BASE_URL%/}/${ORCHESTRATION_ENGINE_RELEASE_TAG}/${ORCHESTRATION_ENGINE_ARTIFACT}"; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${engine_archive}" | sha256sum -c -

FROM ${BASE_IMAGE}

ARG SOURCE_DATE_EPOCH
ARG PASTURESTACK_SERVER_REVISION
ARG WEB_CONSOLE_RELEASE_TAG=1.6.102
ARG WEB_CONSOLE_ARTIFACT_SHA256=6269235a9a23a43b025ca78269ea7d807108c36b007f3eb65c5369c639261bb1
ARG WEB_CONSOLE_COMMIT=9f754ba35ab0c6eaa7d6cd42304f36bb9aba378c
ARG ORCHESTRATION_ENGINE_ARTIFACT_SHA256=2dd6d0637df1fd5e8fc7cafd184f0048ec9ff4b81ac0211f09ab935de0e19615
ARG ORCHESTRATION_ENGINE_COMMIT=5e3e566eff15478f8ba77799fa8a73c18f61e4c7
ARG COMPOSE_EXECUTOR_VERSION=0.14.36
ARG COMPOSE_EXECUTOR_COMMIT=e85545a1bc34cb5c42db62ff90dd82b7ff9f5838
ARG COMPOSE_EXECUTOR_ARCHIVE_SHA256=47e2ba1686c1b136c7edcac530495c3e29c351e947f0b4d08ebe68d33f98cf66
ARG COMPOSE_EXECUTOR_BINARY_SHA256=1f542ee2dd76c7af06bc5f056c381d7e77aecaeac40f8d897df6df24a9902c0d

COPY --from=release_artifacts /out/web-console/ /tmp/pasturestack-web-console/
COPY --from=release_artifacts --chmod=0755 /out/compose-executor /usr/bin/compose-executor.real
COPY --from=release_artifacts /out/orchestration-engine.jar /tmp/orchestration-engine.jar
COPY patches/service-auth.json /tmp/pasturestack-server-overlays/schema/service/service-auth.json
COPY patches/bootstrap.sh /tmp/pasturestack-server-overlays/config-content/bootstrap/bootstrap.sh
COPY patches/db/core-060.xml /tmp/pasturestack-server-overlays/db/core-060.xml
COPY patches/db/core-124.xml /tmp/pasturestack-server-overlays/db/core-124.xml
COPY patches/PatchV1GlobalSubscribe.java /tmp/pasturestack-server-overlays/PatchV1GlobalSubscribe.java

RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    test -n "${PASTURESTACK_SERVER_REVISION}"; \
    archive=/tmp/orchestration-engine.jar; \
    listing=/tmp/orchestration-engine-files.txt; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    unzip -Z1 "${archive}" >"${listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
        echo 'Unsafe Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    if sort "${listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    unzip -p "${archive}" META-INF/MANIFEST.MF | tr -d '\r' | \
        grep -Fx 'Implementation-Version: 0.183.291' >/dev/null; \
    test "$(grep -Ec '^WEB-INF/lib/hazelcast-5\.7\.3-pasturestack\.4\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/hazelcast-(5\.7\.[012]|5\.7\.3-pasturestack\.[0-3])([.-]|\.jar$)' "${listing}"; \
    old_web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${old_web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe existing document root: ${old_web_root}" >&2; exit 1 ;; \
    esac; \
    test -L /usr/share/cattle/war; \
    test -d "${old_web_root}/api-ui"; \
    cp -a "${old_web_root}/api-ui" /tmp/pasturestack-api-ui; \
    install -m 0644 "${archive}" /usr/share/cattle/cattle.jar; \
    engine_hash="$(sha256sum /usr/share/cattle/cattle.jar | awk '{print $1}')"; \
    new_web_root="/usr/share/cattle/${engine_hash}"; \
    test "${new_web_root}" != "${old_web_root}"; \
    rm /usr/share/cattle/war; \
    rm -rf "${old_web_root}" "${new_web_root}"; \
    mkdir -p "${new_web_root}"; \
    ln -s "${engine_hash}" /usr/share/cattle/war; \
    cd "${new_web_root}"; \
    unzip -q ../cattle.jar; \
    if [ -f resources.jar ]; then \
        unzip -oq resources.jar; \
        rm -f resources.jar; \
    fi; \
    resources_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name 'cattle-resources-0.183.291.jar' -print -quit)"; \
    test -n "${resources_jar}"; \
    app_config_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name 'cattle-app-config-0.183.291.jar' -print -quit)"; \
    test -n "${app_config_jar}"; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'supported.docker.range=~v1.12.3 || ~v1.13.0 || ~v17.03.0 || ~v17.06.0 || ~v17.09.0 || ~v17.12.0 || ~v18.03.0 || ~v18.06.0 || ~v18.09.0 || ~v19.03.2 || v24.0.9 || >=v29.4.1 <=v29.7.2' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'newest.docker.version=v29.7.2' >/dev/null; \
    source_date_iso="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%SZ')"; \
    cd /tmp/pasturestack-server-overlays; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/service/service-auth.json \
        config-content/bootstrap/bootstrap.sh \
        db/core-060.xml \
        db/core-124.xml; \
    mkdir -p schema/v1; \
    jar xf "${resources_jar}" \
        schema/v1/admin.ser \
        schema/v1/base.ser \
        schema/v1/member.ser \
        schema/v1/owner.ser \
        schema/v1/project.ser \
        schema/v1/projectadmin.ser \
        schema/v1/readAdmin.ser \
        schema/v1/readonly.ser \
        schema/v1/restricted.ser \
        schema/v1/service.ser \
        schema/v1/superadmin.ser \
        schema/v1/user.ser; \
    javac -cp "${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe.java; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/v1/admin.ser \
        schema/v1/service.ser; \
    cd "${new_web_root}"; \
    rm -rf api-ui; \
    mv /tmp/pasturestack-api-ui api-ui; \
    test "$(readlink -f /usr/share/cattle/war)" = "${new_web_root}"; \
    unzip -p "${resources_jar}" db/core-124.xml | \
        grep -F 'pasturestack-catalog-pinned-commit' >/dev/null; \
    unzip -p "${resources_jar}" schema/service/service-auth.json | \
        grep -F '"subscribe": "cr"' >/dev/null; \
    unzip -p "${resources_jar}" db/core-125.xml | \
        grep -F 'pasturestack-credential-secret-value-mediumtext' >/dev/null; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" \
        /usr/share/cattle/cattle.jar \
        /usr/share/cattle/war \
        "${new_web_root}" \
        "${new_web_root}/api-ui" \
        /tmp; \
    rm -rf /tmp/pasturestack-server-overlays; \
    rm -f "${archive}" "${listing}"

RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    test -n "${PASTURESTACK_SERVER_REVISION}"; \
    web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe Web Console document root: ${web_root}" >&2; exit 1 ;; \
    esac; \
    rm -rf \
        "${web_root}/assets" \
        "${web_root}/ember-fetch" \
        "${web_root}/licenses" \
        "${web_root}/translations"; \
    rm -f \
        "${web_root}/VERSION.txt" \
        "${web_root}/favicon.ico" \
        "${web_root}/humans.txt" \
        "${web_root}/index.html" \
        "${web_root}/robots.txt"; \
    cp -a /tmp/pasturestack-web-console/. "${web_root}/"; \
    rm -rf /tmp/pasturestack-web-console; \
    find "${web_root}/assets" "${web_root}/licenses" "${web_root}/translations" \
        -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +; \
    touch -d "@${SOURCE_DATE_EPOCH}" \
        "${web_root}/VERSION.txt" \
        "${web_root}/favicon.ico" \
        "${web_root}/humans.txt" \
        "${web_root}/index.html" \
        "${web_root}/robots.txt" \
        "${web_root}"; \
    test "$(cat "${web_root}/VERSION.txt")" = "${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(find "${web_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test -z "$(find "${web_root}" -type f -name '*.map' -print -quit)"; \
    for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do \
        theme_path="${web_root}/assets/${theme_asset}"; \
        grep -F 'footer .footer-dropdown .dropdown-menu' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-host-guidance' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-advanced-content.resource-advanced-grid' "${theme_path}" >/dev/null; \
    done; \
    grep -F '"formResources.addUlimit":"新增限制"' \
        "${web_root}/translations/zh-tw.json" >/dev/null; \
    echo "${COMPOSE_EXECUTOR_BINARY_SHA256}  /usr/bin/compose-executor.real" | sha256sum -c -; \
    compose_version_output="$(/usr/bin/compose-executor.real --version 2>&1)"; \
    test "${compose_version_output}" = "pasturestack-compose version ${COMPOSE_EXECUTOR_VERSION}"

LABEL org.opencontainers.image.source="https://github.com/PastureStack/server" \
      org.opencontainers.image.description="PastureStack server image with the reviewed Orchestration Engine service restart-policy fix and the verified Web Console, Compose, and catalog coordinates." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="v1.6.405" \
      org.opencontainers.image.revision="${PASTURESTACK_SERVER_REVISION}" \
      org.opencontainers.image.base.name="ghcr.io/pasturestack/server:v1.6.401" \
      org.opencontainers.image.base.digest="sha256:961ea3de0f550a84034bd18c2f2cb39d72822310887c4605f12fa6dcdb9fddcb"

ENV CATTLE_RANCHER_SERVER_VERSION=v1.6.405
ENV CATTLE_CATTLE_VERSION=v0.183.291
ENV PASTURESTACK_ORCHESTRATION_ENGINE_COMMIT=${ORCHESTRATION_ENGINE_COMMIT}
ENV PASTURESTACK_ORCHESTRATION_ENGINE_ARTIFACT_SHA256=${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}
ENV PASTURESTACK_WEB_CONSOLE_PACKAGE=${WEB_CONSOLE_RELEASE_TAG}
ENV PASTURESTACK_WEB_CONSOLE_COMMIT=${WEB_CONSOLE_COMMIT}
ENV PASTURESTACK_WEB_CONSOLE_ARTIFACT_SHA256=${WEB_CONSOLE_ARTIFACT_SHA256}
ENV PASTURESTACK_COMPOSE_EXECUTOR_VERSION=${COMPOSE_EXECUTOR_VERSION}
ENV PASTURESTACK_COMPOSE_EXECUTOR_COMMIT=${COMPOSE_EXECUTOR_COMMIT}
ENV PASTURESTACK_COMPOSE_EXECUTOR_ARCHIVE_SHA256=${COMPOSE_EXECUTOR_ARCHIVE_SHA256}
ENV PASTURESTACK_COMPOSE_EXECUTOR_BINARY_SHA256=${COMPOSE_EXECUTOR_BINARY_SHA256}
ENV PASTURESTACK_CATALOG_COMMIT=06dfff6234ba8bf163d98e148cc61c0ebd0b2656
ENV DEFAULT_CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"06dfff6234ba8bf163d98e148cc61c0ebd0b2656"}}}'
ENV CATTLE_CATALOG_URL='{"catalogs":{"pasturestack":{"url":"https://github.com/PastureStack/catalog-templates.git","branch":"main","pinnedCommit":"06dfff6234ba8bf163d98e148cc61c0ebd0b2656"}}}'
