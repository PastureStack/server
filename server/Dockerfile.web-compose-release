        printf '%s\n' "${catalog_hash}" | grep -Eq '^[0-9a-f]{64}$'; \
    done; \
    catalog_archive=/tmp/catalog-service.tar.xz; \
    catalog_listing=/tmp/catalog-service-files.txt; \
    fetch-server-component "${COMPONENT_ARTIFACT_MODE}" \
        "${CATALOG_SERVICE_RELEASE_BASE_URL%/}/v${CATALOG_SERVICE_VERSION}/catalog-service-${CATALOG_SERVICE_VERSION}.tar.xz" \
        "catalog-service-${CATALOG_SERVICE_VERSION}.tar.xz" "${CATALOG_SERVICE_ARCHIVE_SHA256}" "${catalog_archive}"; \
    echo "${CATALOG_SERVICE_ARCHIVE_SHA256}  ${catalog_archive}" | sha256sum -c -; \
    tar -tJf "${catalog_archive}" >"${catalog_listing}"; \
