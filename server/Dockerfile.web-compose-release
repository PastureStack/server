ARG COMPOSE_EXECUTOR_VERSION=0.14.36
ARG COMPOSE_EXECUTOR_ARCHIVE_SHA256=47e2ba1686c1b136c7edcac530495c3e29c351e947f0b4d08ebe68d33f98cf66
ARG COMPOSE_EXECUTOR_BINARY_SHA256=1f542ee2dd76c7af06bc5f056c381d7e77aecaeac40f8d897df6df24a9902c0d
ARG VSPHERE_CLI_BUNDLE_VERSION=0.55.2
ARG VSPHERE_CLI_BUNDLE_ARCHIVE_SHA256=bebcc1c0275072ac40b5bc9b80f914c40a7f0431fffebc2c06fe34a34c33a57c
ARG GOVC_BINARY_SHA256=f8c7d82a614655c83ee119e3f170a302a9b35d9ca7efd13bbc226df2d68e5d31

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    command -v curl; \
    command -v gzip; \
    command -v sha256sum; \
    command -v tar; \
    web_archive=/tmp/web-console.tar.gz; \
    web_listing=/tmp/web-console-files.txt; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${web_archive}" \
        "${WEB_CONSOLE_RELEASE_BASE_URL%/}/${WEB_CONSOLE_RELEASE_TAG}/${WEB_CONSOLE_ARTIFACT}"; \
    echo "${WEB_CONSOLE_ARTIFACT_SHA256}  ${web_archive}" | sha256sum -c -; \
    tar -tzf "${web_archive}" >"${web_listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${web_listing}"; then \
        echo 'Unsafe Web Console archive path' >&2; \
        exit 1; \
    fi; \
    if sort "${web_listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate Web Console archive path' >&2; \
        exit 1; \
    fi; \
    if tar -tvzf "${web_archive}" | grep -Eq '^[lh]'; then \
        echo 'Web Console archive may not contain links' >&2; \
        exit 1; \
    fi; \
    while IFS= read -r member; do \
        clean="${member#./}"; \
        case "${clean}" in \
            ${WEB_CONSOLE_RELEASE_TAG}/|${WEB_CONSOLE_RELEASE_TAG}/*) ;; \
            *) echo "Unexpected Web Console archive member: ${member}" >&2; exit 1 ;; \
        esac; \
    done <"${web_listing}"; \
    mkdir -p /out/web-console /tmp/web-console; \
    tar --no-same-owner --no-same-permissions -xzf "${web_archive}" -C /tmp/web-console; \
    package_root="/tmp/web-console/${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(cat "${package_root}/VERSION.txt")" = "${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(find "${package_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test -z "$(find "${package_root}" -type l -print -quit)"; \
    test -z "$(find "${package_root}" -type f -name '*.map' -print -quit)"; \
    ui_entry="$(find "${package_root}/assets" -maxdepth 1 -type f -name 'ui-*.js' -print -quit)"; \
    test -n "${ui_entry}"; \
    grep -aF 'footer-dropdown' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-host-guidance' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-advanced-grid' "${ui_entry}" >/dev/null; \
    for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do \
        theme_path="${package_root}/assets/${theme_asset}"; \
        grep -F 'footer .footer-dropdown .dropdown-menu' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-host-guidance' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-advanced-content.resource-advanced-grid' "${theme_path}" >/dev/null; \
    done; \
    grep -F '"formResources.addUlimit":"新增限制"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    for locale_file in "${package_root}"/translations/*.json; do \
        grep -F '"formResources.addUlimit":' "${locale_file}" >/dev/null; \
    done; \
    cp -a "${package_root}/." /out/web-console/; \
    websocket_archive=/tmp/websocket-proxy.tar.xz; \
    websocket_listing=/tmp/websocket-proxy-files.txt; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${websocket_archive}" \
        "${WEBSOCKET_PROXY_RELEASE_BASE_URL%/}/v${WEBSOCKET_PROXY_VERSION}/websocket-proxy-${WEBSOCKET_PROXY_VERSION}-linux-amd64.tar.xz"; \
    echo "${WEBSOCKET_PROXY_ARCHIVE_SHA256}  ${websocket_archive}" | sha256sum -c -; \
    tar -tJf "${websocket_archive}" >"${websocket_listing}"; \
    test "$(cat "${websocket_listing}")" = websocket-proxy; \
    test "$(wc -l <"${websocket_listing}")" -eq 1; \
    if tar -tvJf "${websocket_archive}" | grep -Eq '^[lh]'; then \
        echo 'WebSocket Proxy archive may not contain links' >&2; \
        exit 1; \
    fi; \
    mkdir -p /out/websocket-proxy; \
    tar --no-same-owner --no-same-permissions -xJf "${websocket_archive}" -C /out/websocket-proxy; \
    echo "${WEBSOCKET_PROXY_BINARY_SHA256}  /out/websocket-proxy/websocket-proxy" | sha256sum -c -; \
    chmod 0755 /out/websocket-proxy/websocket-proxy; \
    compose_archive=/tmp/compose-executor.gz; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${compose_archive}" \
        "https://github.com/PastureStack/compose-cli/releases/download/v${COMPOSE_EXECUTOR_VERSION}/compose-executor-${COMPOSE_EXECUTOR_VERSION}-linux-amd64.gz"; \
    echo "${COMPOSE_EXECUTOR_ARCHIVE_SHA256}  ${compose_archive}" | sha256sum -c -; \
    gzip -dc "${compose_archive}" >/out/compose-executor; \
    chmod 0755 /out/compose-executor; \
    echo "${COMPOSE_EXECUTOR_BINARY_SHA256}  /out/compose-executor" | sha256sum -c -; \
    compose_version_output="$(/out/compose-executor --version 2>&1)"; \
    test "${compose_version_output}" = "compose-executor version ${COMPOSE_EXECUTOR_VERSION}"; \
    engine_archive=/out/orchestration-engine.jar; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${engine_archive}" \
        "${ORCHESTRATION_ENGINE_RELEASE_BASE_URL%/}/${ORCHESTRATION_ENGINE_RELEASE_TAG}/${ORCHESTRATION_ENGINE_ARTIFACT}"; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${engine_archive}" | sha256sum -c -; \
    vsphere_archive=/tmp/vsphere-cli-bundle.tar.xz; \
    vsphere_listing=/tmp/vsphere-cli-bundle-files.txt; \
    vsphere_expected=/tmp/vsphere-cli-bundle-expected.txt; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
        --connect-timeout 10 --max-time 300 \
        -o "${vsphere_archive}" \
        "https://github.com/PastureStack/vsphere-cli-bundle/releases/download/v${VSPHERE_CLI_BUNDLE_VERSION}/vsphere-cli-bundle-${VSPHERE_CLI_BUNDLE_VERSION}-linux-amd64.tar.xz"; \
    echo "${VSPHERE_CLI_BUNDLE_ARCHIVE_SHA256}  ${vsphere_archive}" | sha256sum -c -; \
    tar -tJf "${vsphere_archive}" >"${vsphere_listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${vsphere_listing}"; then \
        echo 'Unsafe vSphere CLI bundle archive path' >&2; \
        exit 1; \
    fi; \
    if sort "${vsphere_listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate vSphere CLI bundle archive path' >&2; \
        exit 1; \
    fi; \
    if tar -tvJf "${vsphere_archive}" | grep -Eq '^[lh]'; then \
        echo 'vSphere CLI bundle archive may not contain links' >&2; \
        exit 1; \
    fi; \
    printf '%s\n' \
        govc \
        vsphere-cli-bundle-LICENSES.txt \
        vsphere-cli-bundle-SOURCES.txt \
        vsphere-cli-bundle-THIRD-PARTY-NOTICES.txt | LC_ALL=C sort >"${vsphere_expected}"; \
    LC_ALL=C sort "${vsphere_listing}" | cmp "${vsphere_expected}" -; \
    mkdir -p /out/vsphere-cli-bundle; \
    tar --no-same-owner --no-same-permissions -xJf "${vsphere_archive}" \
        -C /out/vsphere-cli-bundle; \
    echo "${GOVC_BINARY_SHA256}  /out/vsphere-cli-bundle/govc" | sha256sum -c -; \
    chmod 0755 /out/vsphere-cli-bundle/govc; \
    test "$(/out/vsphere-cli-bundle/govc version)" = "govc ${VSPHERE_CLI_BUNDLE_VERSION}"; \
    grep -Fx 'Pinned source commit: a668d9c60399552ea96782b8751c956720a0b8fb' \
        /out/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt >/dev/null; \
    grep -Fx 'Build Go version: 1.27.0' \
        /out/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt >/dev/null; \
    grep -Fx "Binary SHA-256: ${GOVC_BINARY_SHA256}" \
        /out/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt >/dev/null

FROM ${BASE_IMAGE}

ARG SOURCE_DATE_EPOCH
ARG PASTURESTACK_SERVER_REVISION
ARG UBUNTU_SNAPSHOT=20260909T000000Z
ARG GLIBC_PACKAGE_VERSION=2.43-2ubuntu2.4
ARG PERL_PACKAGE_VERSION=5.40.1-7ubuntu0.2
ARG WEB_CONSOLE_RELEASE_TAG=1.6.103
ARG WEB_CONSOLE_ARTIFACT_SHA256=8d469d7eb3329402a3a201bdbd8d7a0bc3c1600eb0bdf3a5c99f0d7484fc65ee
ARG WEB_CONSOLE_COMMIT=00ff7a76a1606aab4fc5c08e0c863989d266eec9
ARG WEBSOCKET_PROXY_VERSION=0.23.14
ARG WEBSOCKET_PROXY_COMMIT=3b5788bdc52f4edab0097a3d97afccf138c64089
ARG WEBSOCKET_PROXY_ARCHIVE_SHA256=c55108c3dbfd8e6579fc768a1988920db83c6f605ca1284b60edf92ae8d0160e
ARG WEBSOCKET_PROXY_BINARY_SHA256=efd0c78779a620b4b0f74a10eb3f3edd8886e8d23f22dc4624d8e9971085a26d
ARG ORCHESTRATION_ENGINE_ARTIFACT_SHA256=1e49dac19043cb1579a0449f0d8874ebe5d1777c1231bff61dca793f58fe0b73
ARG ORCHESTRATION_ENGINE_COMMIT=b59ddee9d79dcffa8b95a00dd9182fe5304b619b
ARG COMPOSE_EXECUTOR_VERSION=0.14.36
ARG COMPOSE_EXECUTOR_COMMIT=e85545a1bc34cb5c42db62ff90dd82b7ff9f5838
ARG COMPOSE_EXECUTOR_ARCHIVE_SHA256=47e2ba1686c1b136c7edcac530495c3e29c351e947f0b4d08ebe68d33f98cf66
ARG COMPOSE_EXECUTOR_BINARY_SHA256=1f542ee2dd76c7af06bc5f056c381d7e77aecaeac40f8d897df6df24a9902c0d
ARG VSPHERE_CLI_BUNDLE_VERSION=0.55.2
ARG VSPHERE_CLI_BUNDLE_COMMIT=c4b27e87aa0dacce432a2c6108ee0752319e6d5b
ARG VSPHERE_CLI_BUNDLE_ARCHIVE_SHA256=bebcc1c0275072ac40b5bc9b80f914c40a7f0431fffebc2c06fe34a34c33a57c
ARG GOVC_BINARY_SHA256=f8c7d82a614655c83ee119e3f170a302a9b35d9ca7efd13bbc226df2d68e5d31

COPY --from=ubuntu_security_packages /out/ /tmp/pasturestack-ubuntu-security/
COPY --from=release_artifacts /out/web-console/ /tmp/pasturestack-web-console/
COPY --from=release_artifacts --chmod=0755 /out/websocket-proxy/websocket-proxy /usr/bin/websocket-proxy.real
COPY --from=release_artifacts --chmod=0755 /out/compose-executor /usr/bin/compose-executor.real
COPY --from=release_artifacts /out/orchestration-engine.jar /tmp/orchestration-engine.jar
COPY --from=release_artifacts --chmod=0755 /out/vsphere-cli-bundle/govc /usr/bin/govc
COPY --from=release_artifacts /out/vsphere-cli-bundle/vsphere-cli-bundle-LICENSES.txt /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-LICENSES.txt
COPY --from=release_artifacts /out/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-SOURCES.txt
COPY --from=release_artifacts /out/vsphere-cli-bundle/vsphere-cli-bundle-THIRD-PARTY-NOTICES.txt /usr/share/licenses/pasturestack/vsphere-cli-bundle/vsphere-cli-bundle-THIRD-PARTY-NOTICES.txt
COPY --from=console_broker_build --chmod=0755 /out/pasturestack-console-broker /usr/bin/pasturestack-console-broker
COPY patches/service-auth.json /tmp/pasturestack-server-overlays/schema/service/service-auth.json
COPY patches/bootstrap.sh /tmp/pasturestack-server-overlays/config-content/bootstrap/bootstrap.sh
COPY patches/db/core-060.xml /tmp/pasturestack-server-overlays/db/core-060.xml
COPY patches/db/core-124.xml /tmp/pasturestack-server-overlays/db/core-124.xml
COPY patches/PatchV1GlobalSubscribe.java /tmp/pasturestack-server-overlays/PatchV1GlobalSubscribe.java

RUN set -eux; \
    cd /tmp/pasturestack-ubuntu-security; \
    sha256sum -c SHA256SUMS; \
    install -o 0 -g 0 -m 0755 tar /usr/bin/tar; \
    dpkg -i packages/*.deb; \
    for package in libc6 libc-bin libc-gconv-modules-extra; do \
      test "$(dpkg-query -W -f='${Version}' "${package}")" = "${GLIBC_PACKAGE_VERSION}"; \
    done; \
    for package in libperl5.40 perl perl-base perl-modules-5.40; do \
      test "$(dpkg-query -W -f='${Version}' "${package}")" = "${PERL_PACKAGE_VERSION}"; \
    done; \
    cd /; \
    rm -rf /tmp/pasturestack-ubuntu-security; \
    rm -f /usr/bin/tar

RUN set -eux; \
    test -n "${SOURCE_DATE_EPOCH}"; \
    test -n "${PASTURESTACK_SERVER_REVISION}"; \
    archive=/tmp/orchestration-engine.jar; \
    listing=/tmp/orchestration-engine-files.txt; \
    echo "${ORCHESTRATION_ENGINE_ARTIFACT_SHA256}  ${archive}" | sha256sum -c -; \
    unzip -Z1 "${archive}" >"${listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${listing}"; then \
        echo 'Unsafe Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    if sort "${listing}" | uniq -d | grep -q .; then \
        echo 'Duplicate Orchestration Engine JAR path' >&2; \
        exit 1; \
    fi; \
    unzip -p "${archive}" META-INF/MANIFEST.MF | tr -d '\r' | \
        grep -Fx 'Implementation-Version: 0.183.294' >/dev/null; \
    test "$(grep -Ec '^WEB-INF/lib/hazelcast-5\.7\.4\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/hazelcast-(5\.7\.[0-3]|5\.7\.3-pasturestack\.[0-9]+)([.-]|\.jar$)' "${listing}"; \
    old_web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${old_web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe existing document root: ${old_web_root}" >&2; exit 1 ;; \
    esac; \
    test -L /usr/share/cattle/war; \
    test -d "${old_web_root}/api-ui"; \
    cp -a "${old_web_root}/api-ui" /tmp/pasturestack-api-ui; \
    install -m 0644 "${archive}" /usr/share/cattle/cattle.jar; \
    engine_hash="$(sha256sum /usr/share/cattle/cattle.jar | awk '{print $1}')"; \
    new_web_root="/usr/share/cattle/${engine_hash}"; \
    test "${new_web_root}" != "${old_web_root}"; \
    rm /usr/share/cattle/war; \
    rm -rf "${old_web_root}" "${new_web_root}"; \
    mkdir -p "${new_web_root}"; \
    ln -s "${engine_hash}" /usr/share/cattle/war; \
    cd "${new_web_root}"; \
    unzip -q ../cattle.jar; \
    if [ -f resources.jar ]; then \
        unzip -oq resources.jar; \
        rm -f resources.jar; \
    fi; \
    resources_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name 'cattle-resources-0.183.294.jar' -print -quit)"; \
    test -n "${resources_jar}"; \
    app_config_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name 'cattle-app-config-0.183.294.jar' -print -quit)"; \
    test -n "${app_config_jar}"; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'supported.docker.range=~v1.12.3 || ~v1.13.0 || ~v17.03.0 || ~v17.06.0 || ~v17.09.0 || ~v17.12.0 || ~v18.03.0 || ~v18.06.0 || ~v18.09.0 || ~v19.03.2 || v24.0.9 || >=v29.4.1 <=v29.7.2' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'newest.docker.version=v29.7.2' >/dev/null; \
    source_date_iso="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%SZ')"; \
    cd /tmp/pasturestack-server-overlays; \
