RUN set -eux; \
    for release_base_url in "${COMPOSE_EXECUTOR_RELEASE_BASE_URL}" "${VSPHERE_CLI_BUNDLE_RELEASE_BASE_URL}"; do \
        case "${release_base_url}" in \
            https://*) ;; \
            http://127.0.0.1:*|http://localhost:*) test "${PASTURESTACK_ALLOW_LOOPBACK_ARTIFACTS}" = 1 ;; \
            *) echo 'Release artifact source must use HTTPS or an explicitly allowed loopback address' >&2; exit 1 ;; \
        esac; \
    done; \
    printf '%s\n' "${WEB_CONSOLE_ARTIFACT_SHA256}" | grep -Eq '^[0-9a-f]{64}$'; \
    apt-get update; \
    apt-get install -y --no-install-recommends xz-utils python3-minimal; \
    rm -rf /var/lib/apt/lists/*; \
    command -v curl; \
    command -v gzip; \
    command -v sha256sum; \
    command -v tar; \
    test -n "${WEB_CONSOLE_ARTIFACT_SHA256}"; \
    web_archive=/tmp/web-console.tar.gz; \
    web_listing=/tmp/web-console-files.txt; \
    fetch-server-component "${COMPONENT_ARTIFACT_MODE}" \
        "${WEB_CONSOLE_ASSET_API_URL}" \
        "${WEB_CONSOLE_ARTIFACT}" "${WEB_CONSOLE_ARTIFACT_SHA256}" "${web_archive}"; \
    echo "${WEB_CONSOLE_ARTIFACT_SHA256}  ${web_archive}" | sha256sum -c -; \
    web_sbom=/tmp/web-console-runtime.cdx.json; \
    fetch-server-component "${COMPONENT_ARTIFACT_MODE}" \
        "${WEB_CONSOLE_SBOM_ASSET_API_URL}" \
        "${WEB_CONSOLE_RUNTIME_SBOM_ARTIFACT}" "${WEB_CONSOLE_RUNTIME_SBOM_SHA256}" "${web_sbom}"; \
    python3 /usr/local/bin/verify-web-console-sbom \
        --sbom "${web_sbom}" --sbom-sha256 "${WEB_CONSOLE_RUNTIME_SBOM_SHA256}" \
        --version "${WEB_CONSOLE_RELEASE_TAG}" --source-commit "${WEB_CONSOLE_COMMIT}" \
        --archive-name "${WEB_CONSOLE_ARTIFACT}" --archive-sha256 "${WEB_CONSOLE_ARTIFACT_SHA256}" \
        --lock-sha256 "${WEB_CONSOLE_LOCK_SHA256}" --archive "${web_archive}" \
        --webmcp-ceiling enabled; \
    mkdir -p /out/runtime-licenses/web-console; \
    install -m 0644 "${web_sbom}" /out/runtime-licenses/web-console/runtime.cdx.json; \
    tar -tzf "${web_archive}" >"${web_listing}"; \
    if grep -Eq '(^/|(^|/)\.\.(/|$))' "${web_listing}"; then \
        echo 'Unsafe Web Console archive path' >&2; \
        exit 1; \
    fi; \
    sort "${web_listing}" | uniq -d > /tmp/pasturestack-archive-duplicates.txt; \
    if test -s /tmp/pasturestack-archive-duplicates.txt; then \
        echo 'Duplicate Web Console archive path' >&2; \
        exit 1; \
    fi; \
    tar -tvzf "${web_archive}" > /tmp/pasturestack-archive-verbose.txt; \
    if grep -Eq '^[lh]' /tmp/pasturestack-archive-verbose.txt; then \
        echo 'Web Console archive may not contain links' >&2; \
        exit 1; \
    fi; \
    while IFS= read -r member; do \
        clean="${member#./}"; \
        case "${clean}" in \
            ${WEB_CONSOLE_RELEASE_TAG}/|${WEB_CONSOLE_RELEASE_TAG}/*) ;; \
            *) echo "Unexpected Web Console archive member: ${member}" >&2; exit 1 ;; \
        esac; \
    done <"${web_listing}"; \
    mkdir -p /out/web-console /tmp/web-console; \
    tar --no-same-owner --no-same-permissions -xzf "${web_archive}" -C /tmp/web-console; \
    package_root="/tmp/web-console/${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(cat "${package_root}/VERSION.txt")" = "${WEB_CONSOLE_RELEASE_TAG}"; \
    test "$(find "${package_root}/translations" -maxdepth 1 -type f -name '*.json' | wc -l)" -eq 13; \
    test -z "$(find "${package_root}" -type l -print -quit)"; \
    test -z "$(find "${package_root}" -type f -name '*.map' -print -quit)"; \
    ui_entry="$(find "${package_root}/assets" -maxdepth 1 -type f -name 'ui-*.js' -print -quit)"; \
    test -n "${ui_entry}"; \
    grep -aF 'footer-dropdown' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-host-guidance' "${ui_entry}" >/dev/null; \
    grep -aF 'resource-advanced-grid' "${ui_entry}" >/dev/null; \
    grep -aF 'hostsPage.permissionDenied' "${ui_entry}" >/dev/null; \
    grep -aF 'resourceLoadError.serviceUnavailable' "${ui_entry}" >/dev/null; \
    grep -aF 'resourceLoadError.serviceFailed' "${ui_entry}" >/dev/null; \
    grep -aF 'resourceLoadError.secretsUnavailable' "${ui_entry}" >/dev/null; \
    grep -aF 'resourceLoadError.secretsFailed' "${ui_entry}" >/dev/null; \
    grep -aF 'growl-mount' "${ui_entry}" >/dev/null; \
    for key_policy_marker in ui/utils/api-key-policy-matrix ui/components/api-key-policy-matrix/template \
        data-policy-matrix data-access-default data-matrix-basis; do \
        grep -aF "${key_policy_marker}" "${ui_entry}" >/dev/null; \
    done; \
    for permission_key in routePermission.title routePermission.denied routePermission.updateDenied; do \
        grep -aF "${permission_key}" "${ui_entry}" >/dev/null; \
    done; \
    grep -aF 'pod-empty-message text-center text-muted' "${ui_entry}" >/dev/null; \
    for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do \
        theme_path="${package_root}/assets/${theme_asset}"; \
        grep -F -A 2 ".jGrowl.top-right {" "${theme_path}" | grep -Fx "  top: 45px;" >/dev/null; \
        grep -F -A 4 ".jGrowl .jGrowl-closer {" "${theme_path}" | grep -Fx "  max-width: calc(100vw - 20px);" >/dev/null; \
        grep -F -A 5 "#growl-mount .jGrowl.top-right {" "${theme_path}" | grep -Fx "  position: static;" >/dev/null; \
        grep -F -A 3 '.pods .pod-empty-message {' "${theme_path}" | grep -Fx '  white-space: normal;' >/dev/null; \
        grep -F -A 3 '.pods .pod-empty-message {' "${theme_path}" | grep -Fx '  overflow-wrap: anywhere;' >/dev/null; \
        grep -F 'footer .footer-dropdown .dropdown-menu' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-host-guidance' "${theme_path}" >/dev/null; \
        grep -F '.form-resources .resource-advanced-content.resource-advanced-grid' "${theme_path}" >/dev/null; \
    done; \
    grep -F '"formResources.addUlimit":"新增限制"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"hostsPage.permissionDenied":"您沒有權限在此環境中新增主機。"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.title":"無法執行此操作"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.denied":"您沒有權限在此環境中建立此資源。"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    grep -F '"routePermission.updateDenied":"您沒有權限在此環境中更新此資源。"' \
        "${package_root}/translations/zh-tw.json" >/dev/null; \
    for permission_locale in en-us zh-tw ja-jp; do \
        locale_file="${package_root}/translations/${permission_locale}.json"; \
        for permission_key in routePermission.title routePermission.denied routePermission.updateDenied; do \
            grep -F "\"${permission_key}\":" "${locale_file}" >/dev/null; \
        done; \
        for load_key in serviceUnavailable serviceFailed secretsUnavailable secretsFailed; do \
            grep -F "\"resourceLoadError.${load_key}\":" "${locale_file}" >/dev/null; \
        done; \
    done; \
    for locale_file in "${package_root}"/translations/*.json; do \
        grep -F '"formResources.addUlimit":' "${locale_file}" >/dev/null; \
        grep -F '"hostsPage.permissionDenied":' "${locale_file}" >/dev/null; \
        for validation_label in \
            formNameDescription.name.label \
            formNameDescription.description.label \
            newSecret.value.label \
            newSecret.name.editHelp \
            inputCertificate.cert.label \
