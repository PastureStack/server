    fi; \
    unzip -p "${archive}" META-INF/MANIFEST.MF | tr -d '\r' | \
        grep -Fx "Implementation-Version: ${ORCHESTRATION_ENGINE_VERSION}" >/dev/null; \
    test "$(grep -Ec '^WEB-INF/lib/freemarker-2\.3\.35\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/freemarker-2\.3\.(3[0-4]|[0-2][0-9])\.jar$' "${listing}"; \
    test "$(grep -Ec '^WEB-INF/lib/hazelcast-5\.7\.5\.jar$' "${listing}")" -eq 1; \
    ! grep -Eq '^WEB-INF/lib/hazelcast-(5\.7\.[0-4]|5\.7\.3-pasturestack\.[0-9]+)([.-]|\.jar$)' "${listing}"; \
    old_web_root="$(readlink -f /usr/share/cattle/war)"; \
    case "${old_web_root}" in \
        /usr/share/cattle/*) ;; \
        *) echo "Unsafe existing document root: ${old_web_root}" >&2; exit 1 ;; \
    esac; \
    test -L /usr/share/cattle/war; \
    install -m 0644 "${archive}" /usr/share/cattle/cattle.jar; \
    engine_hash="$(sha256sum /usr/share/cattle/cattle.jar | awk '{print $1}')"; \
    new_web_root="/usr/share/cattle/${engine_hash}"; \
    if [ "${new_web_root}" != "${old_web_root}" ]; then \
        rm /usr/share/cattle/war; \
        rm -rf "${old_web_root}" "${new_web_root}"; \
        mkdir -p "${new_web_root}"; \
        ln -s "${engine_hash}" /usr/share/cattle/war; \
        cd "${new_web_root}"; \
        unzip -q ../cattle.jar; \
        if [ -f resources.jar ]; then \
            unzip -oq resources.jar; \
            rm -f resources.jar; \
        fi; \
    else \
        test "$(readlink -f /usr/share/cattle/war)" = "${new_web_root}"; \
        test -d "${new_web_root}/WEB-INF/lib"; \
    fi; \
    resources_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name "cattle-resources-${ORCHESTRATION_ENGINE_VERSION}.jar" -print -quit)"; \
    test -n "${resources_jar}"; \
    unzip -p "${resources_jar}" schema/user/user-auth.json | \
        grep -F '"volume.isNative" : "r"' >/dev/null; \
    test "$(unzip -p "${resources_jar}" schema/v1/readonly.ser | sha256sum | cut -d' ' -f1)" = \
        "${ENGINE_READONLY_SCHEMA_SHA256}"; \
    test "$(unzip -p "${resources_jar}" schema/v1/restricted.ser | sha256sum | cut -d' ' -f1)" = \
        "${ENGINE_RESTRICTED_SCHEMA_SHA256}"; \
    unzip -p "${resources_jar}" schema/base/mfaOperation.json | \
        grep -F 'oidcAccessPolicyUpdate' >/dev/null; \
    unzip -p "${resources_jar}" schema/base/mfaOperation.json | \
        grep -F '"requestDigest"' >/dev/null; \
    unzip -p "${resources_jar}" schema/token/token-auth.json | \
        grep -F '"token.clientSessionId": "cro"' >/dev/null; \
    for frozen_token_schema in base superadmin token; do \
        unzip -p "${resources_jar}" "schema/v1/${frozen_token_schema}.ser" | \
            grep -aF 'clientSessionId' >/dev/null; \
    done; \
    unzip -p "${resources_jar}" cattle-global.properties | \
        grep -Fx 'auth.service.external.id.types=github_user,github_org,github_team,shibboleth_user,shibboleth_group,ldap_user,ldap_group,oidc_user,oidc_group' >/dev/null; \
    for oidc_type in oidc_user oidc_group; do \
        unzip -p "${resources_jar}" schema/base/projectMember.json | \
            grep -F "\"${oidc_type}\"" >/dev/null; \
    done; \
    app_config_jar="$(find "${new_web_root}/WEB-INF/lib" -maxdepth 1 -type f \
        -name "cattle-app-config-${ORCHESTRATION_ENGINE_VERSION}.jar" -print -quit)"; \
    test -n "${app_config_jar}"; \
    unzip -p "${app_config_jar}" META-INF/cattle/iaas-api/defaults.properties | \
        grep -Fx 'auth.service.external.id.types=github_user,github_org,github_team,shibboleth_user,shibboleth_group,ldap_user,ldap_group,oidc_user,oidc_group' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'supported.docker.range=~v1.12.3 || ~v1.13.0 || ~v17.03.0 || ~v17.06.0 || ~v17.09.0 || ~v17.12.0 || ~v18.03.0 || ~v18.06.0 || ~v18.09.0 || ~v19.03.2 || v24.0.9 || >=v29.4.1 <=v29.7.2 || v29.8.0' >/dev/null; \
    unzip -p "${app_config_jar}" META-INF/cattle/api-server/defaults.properties | \
        grep -Fx 'newest.docker.version=v29.8.0' >/dev/null; \
    source_date_iso="$(date -u -d "@${SOURCE_DATE_EPOCH}" '+%Y-%m-%dT%H:%M:%SZ')"; \
    cd /tmp/pasturestack-server-overlays; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/service/service-auth.json \
        config-content/bootstrap/bootstrap.sh \
        db/core-060.xml \
        db/core-124.xml; \
    mkdir -p schema/v1; \
    jar xf "${resources_jar}" \
        schema/v1/admin.ser \
        schema/v1/base.ser \
        schema/v1/member.ser \
        schema/v1/owner.ser \
        schema/v1/project.ser \
        schema/v1/projectadmin.ser \
        schema/v1/readAdmin.ser \
        schema/v1/readonly.ser \
        schema/v1/restricted.ser \
        schema/v1/service.ser \
        schema/v1/superadmin.ser \
        schema/v1/user.ser; \
    javac -cp "${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe.java; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify; \
    java -cp ".:${new_web_root}/WEB-INF/lib/*" PatchV1GlobalSubscribe verify-hardware; \
    jar --update --file "${resources_jar}" --date="${source_date_iso}" \
        schema/v1/admin.ser \
        schema/v1/service.ser; \
    cd "${new_web_root}"; \
    rm -rf api-ui; \
    mv /tmp/pasturestack-api-ui api-ui; \
    (cd api-ui && sha256sum -c /tmp/pasturestack-api-ui.sha256); \
    rm -f /tmp/pasturestack-api-ui.sha256; \
    sed -i '/^export \(DEFAULT_\)\?CATTLE_API_UI_VERSION=/d' /usr/share/cattle/env_vars; \
    printf 'export DEFAULT_CATTLE_API_UI_VERSION=1.1.20\nexport CATTLE_API_UI_VERSION=1.1.20\n' >> /usr/share/cattle/env_vars; \
    test "$(readlink -f /usr/share/cattle/war)" = "${new_web_root}"; \
    unzip -p "${resources_jar}" db/core-124.xml | \
        grep -F 'pasturestack-catalog-pinned-commit' >/dev/null; \
    unzip -p "${resources_jar}" schema/service/service-auth.json | \
        grep -F '"subscribe": "cr"' >/dev/null; \
    unzip -p "${resources_jar}" db/core-125.xml | \
        grep -F 'pasturestack-credential-secret-value-mediumtext' >/dev/null; \
    touch -h -d "@${SOURCE_DATE_EPOCH}" \
        /usr/share/cattle/cattle.jar \
        /usr/share/cattle/war \
        "${new_web_root}" \
        "${new_web_root}/api-ui" \
        /tmp; \
    rm -rf /tmp/pasturestack-server-overlays; \
    rm -f "${archive}" "${listing}"

