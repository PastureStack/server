COPY --from=runtime_security_packages /out/ /tmp/pasturestack-runtime-security/
COPY --from=runtime_security_packages /out/tar /usr/bin/tar
RUN set -eux; \
    printf '%s\n' "${WEB_CONSOLE_COMMIT}" | grep -Eq '^[0-9a-f]{40}$'; \
    cd /tmp/pasturestack-runtime-security; \
    sha256sum -c SHA256SUMS; \
    dpkg -i packages/*.deb; \
    for package in curl libcurl3t64-gnutls libcurl4t64; do \
        test "$(dpkg-query -W -f='${Version}' "${package}")" = "${CURL_PACKAGE_VERSION}"; \
    done; \
    for package in openssl libssl3t64 openssl-provider-legacy; do \
        test "$(dpkg-query -W -f='${Version}' "${package}")" = "${OPENSSL_PACKAGE_VERSION}"; \
    done; \
    test "$(dpkg-query -W -f='${Version}' libdbi-perl)" = "${LIBDBI_PERL_PACKAGE_VERSION}"; \
    test "$(dpkg-query -W -f='${Version}' libfreetype6)" = "${FREETYPE_PACKAGE_VERSION}"; \
    install -D -m 0644 libdbi-perl-runtime.sha256 /usr/share/pasturestack/security/libdbi-perl-runtime.sha256; \
    install -D -m 0644 freetype-runtime.sha256 /usr/share/pasturestack/security/freetype-runtime.sha256; \
    install -D -m 0644 openssl-runtime.sha256 /usr/share/pasturestack/security/openssl-runtime.sha256; \
    cd /; \
    test "$(wc -l < /usr/share/pasturestack/security/freetype-runtime.sha256)" -eq 1; \
    sha256sum -c /usr/share/pasturestack/security/freetype-runtime.sha256; \
    test "$(readlink -f /usr/lib/x86_64-linux-gnu/libfreetype.so.6)" = /usr/lib/x86_64-linux-gnu/libfreetype.so.6.20.5; \
    freetype_linkage="$(ldd -r /usr/lib/x86_64-linux-gnu/libfreetype.so.6 2>&1)"; \
    ! printf '%s\n' "${freetype_linkage}" | grep -E 'not found|undefined symbol'; \
    test "$(wc -l < /usr/share/pasturestack/security/libdbi-perl-runtime.sha256)" -eq 2; \
    sha256sum -c /usr/share/pasturestack/security/libdbi-perl-runtime.sha256; \
    perl -MDBI -e 'die "Unexpected DBI runtime version\n" unless $DBI::VERSION eq "1.647"'; \
    test "$(wc -l < /usr/share/pasturestack/security/openssl-runtime.sha256)" -eq 7; \
    sha256sum -c /usr/share/pasturestack/security/openssl-runtime.sha256; \
    openssl version | grep -E '^OpenSSL 3\.5\.5 .*\(Library: OpenSSL 3\.5\.5 '; \
    rm -rf /tmp/pasturestack-runtime-security /usr/share/licenses/pasturestack/openssl-3.5.8; \
    rm -f /usr/bin/tar

